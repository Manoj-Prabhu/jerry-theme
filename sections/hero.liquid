{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
%}

{% if slide_blocks.size > 0 %}

  <div
    class="j-hero-slideshow"
    data-autoplay="3000"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.heading | default: 'Hero' }}"
  >

    <div class="j-hero-slideshow__track">
      {% for block in slide_blocks %}
        {% liquid
          assign img_loading = 'lazy'
          assign img_priority = 'auto'
          if forloop.first
            assign img_loading = 'eager'
            assign img_priority = 'high'
          endif
        %}

        <div
          class="j-hero j-hero-slideshow__slide{% if forloop.first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >

          <div class="j-hero__content">

            {% if block.settings.badge != blank %}
              <span class="j-hero__badge">{{ block.settings.badge }}</span>
            {% endif %}

            <h1>
              {{ block.settings.heading }}
              <span>{{ block.settings.highlight_heading }}</span>
            </h1>

            <p>{{ block.settings.description }}</p>

            <div class="j-hero__buttons">
              <a
                href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                class="j-button"
              >
                {{ block.settings.button_label }}
              </a>

              <a
                href="{{ block.settings.secondary_link | default: routes.all_products_collection_url }}"
                class="j-button j-button-outline"
              >
                {{ block.settings.secondary_label }}
              </a>
            </div>

            {% render 'hero-trust', trust_blocks: trust_blocks %}

          </div>

          <div class="j-hero__image">

            {% if block.settings.image %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: img_loading,
                  fetchpriority: img_priority,
                  widths: '480, 760, 1000, 1200',
                  sizes: '(max-width: 991px) 90vw, 560px',
                  class: 'j-hero__img',
                  alt: block.settings.heading
              }}
            {% else %}
              <div class="j-hero__placeholder">
                <div class="floating-circle"></div>
                <div class="floating-square"></div>
                <div class="floating-dot"></div>
              </div>
            {% endif %}

            {% if slide_blocks.size > 1 %}
              <button
                type="button"
                class="j-hero-slideshow__arrow j-hero-slideshow__arrow--prev"
                aria-label="{{ 'general.pagination.prev' | t }}"
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <button
                type="button"
                class="j-hero-slideshow__arrow j-hero-slideshow__arrow--next"
                aria-label="{{ 'general.pagination.next' | t }}"
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M7.5 5 12.5 10l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            {% endif %}

          </div>

        </div>
      {% endfor %}
    </div>

  </div>

{% else %}

  <div class="j-hero">

    <div class="j-hero__content">

      <span class="j-hero__badge">
        {{ section.settings.badge }}
      </span>

      <h1>
        {{ section.settings.heading }}
        <span>{{ section.settings.highlight_heading }}</span>
      </h1>

      <p>
        {{ section.settings.description }}
      </p>

      <div class="j-hero__buttons">
        <a
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          class="j-button"
        >
          {{ section.settings.button_label }}
        </a>

        <a
          href="{{ section.settings.secondary_link | default: routes.all_products_collection_url }}"
          class="j-button j-button-outline"
        >
          {{ section.settings.secondary_label }}
        </a>
      </div>

      {% render 'hero-trust', trust_blocks: trust_blocks %}

    </div>

    <div class="j-hero__image">

      {% if section.settings.image %}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            widths: '480, 760, 1000, 1200',
            sizes: '(max-width: 991px) 90vw, 560px',
            class: 'j-hero__img',
            alt: section.settings.heading
        }}
      {% else %}
        <div class="j-hero__placeholder">
          <div class="floating-circle"></div>
          <div class="floating-square"></div>
          <div class="floating-dot"></div>
        </div>
      {% endif %}

    </div>

  </div>

{% endif %}

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Used only when no Slide blocks are added below."
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Premium Lifestyle Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover Your"
    },
    {
      "type": "text",
      "id": "highlight_heading",
      "label": "Highlighted Heading",
      "default": "Next Favorite"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Carefully selected products crafted for modern living. Simple. Elegant. Timeless."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary Button",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary Button Link"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Premium Lifestyle Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover Your"
        },
        {
          "type": "text",
          "id": "highlight_heading",
          "label": "Highlighted Heading",
          "default": "Next Favorite"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Carefully selected products crafted for modern living. Simple. Elegant. Timeless."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary Button",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary Button Link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary Button",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary Button Link"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure" },
            { "value": "quality", "label": "Quality" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "trust_item",
          "settings": { "icon": "shipping", "text": "Free Shipping" }
        },
        {
          "type": "trust_item",
          "settings": { "icon": "returns", "text": "Easy Returns" }
        },
        {
          "type": "trust_item",
          "settings": { "icon": "secure", "text": "Secure Checkout" }
        }
      ]
    }
  ]
}
{% endschema %}
