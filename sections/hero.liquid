{% liquid
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign trust_blocks = section.blocks | where: 'type', 'trust_item'
%}

{% style %}
  {{ section.settings.button_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .j-hero__buttons .j-button {
    font-family: {{ section.settings.button_font.family }}, {{ section.settings.button_font.fallback_families }};
    font-style: {{ section.settings.button_font.style }};
    font-weight: {{ section.settings.button_font.weight }};
  }

  {{ section.settings.trust_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .j-hero__trust-item {
    font-family: {{ section.settings.trust_font.family }}, {{ section.settings.trust_font.fallback_families }};
    font-style: {{ section.settings.trust_font.style }};
    font-weight: {{ section.settings.trust_font.weight }};
  }

  {{ section.settings.description_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .j-hero__content p {
    font-family: {{ section.settings.description_font.family }}, {{ section.settings.description_font.fallback_families }};
    font-style: {{ section.settings.description_font.style }};
    font-weight: {{ section.settings.description_font.weight }};
  }

  {{ section.settings.badge_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .j-hero__badge {
    font-family: {{ section.settings.badge_font.family }}, {{ section.settings.badge_font.fallback_families }};
    font-style: {{ section.settings.badge_font.style }};
    font-weight: {{ section.settings.badge_font.weight }};
  }
{% endstyle %}

<div class="j-hero-band full-width">

  <div
    class="j-hero-slideshow"
    data-autoplay="3000"
    role="region"
    aria-roledescription="carousel"
    aria-label="Hero"
  >

    <div class="j-hero-slideshow__track">
      {% for block in slide_blocks %}
        <div
          class="j-hero j-hero-slideshow__slide{% if forloop.first %} is-active{% endif %}"
          data-slide-index="{{ forloop.index0 }}"
          {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
          {{ block.shopify_attributes }}
        >

          <div class="j-hero__content">

            {% if block.settings.badge != blank %}
              <span class="j-hero__badge">{{ block.settings.badge }}</span>
            {% endif %}

            <h1>
              {{ block.settings.heading }}
              <span class="j-hero__highlight">{{ block.settings.highlight_heading }}</span>
            </h1>

            <p>{{ block.settings.description }}</p>

            <div class="j-hero__buttons">
              <a
                href="{{ block.settings.button_link | default: routes.all_products_collection_url }}"
                class="j-button"
              >
                {{ block.settings.button_label }}
              </a>

              <a
                href="{{ block.settings.secondary_link | default: routes.all_products_collection_url }}"
                class="j-button j-button-outline"
              >
                {{ block.settings.secondary_label }}
              </a>
            </div>

            {% render 'hero-trust', trust_blocks: trust_blocks %}

          </div>

          {% comment %}
            aria-hidden — this is purely decorative background media (the
            actual slide content — heading, description, CTA — is marked
            up separately as real text below), and it's always muted with
            no spoken audio, so a captions track wouldn't convey anything
            a screen reader user needs. Hiding it from assistive tech
            entirely is the correct treatment here, rather than adding a
            captions track with nothing meaningful to caption.
          {% endcomment %}
          <div class="j-hero__image" aria-hidden="true">

            {% if block.settings.video %}

              {% comment %}
                Only the first/active slide's video is eager + autoplaying.
                Other slides get their <source> deferred the same way
                images are (data-src, hydrated on idle) — a video file is
                far heavier than an image, so downloading N of them
                upfront for slides the visitor may never reach is worse
                here than it ever was for photos. hero-slideshow.js starts
                playback only once a slide actually becomes active, and
                pauses it again when the slide is left, so at most one
                hero video is ever playing at a time.
              {% endcomment %}

              {% comment %}
                video_tag lists every rendition Shopify generated, and a
                browser plays the first source it supports — normally the
                largest mp4 (often 1080p, several MB per slide) for a hero
                whose box is at most ~560px wide on desktop and full-width
                but only ~412px on a phone. Picking the largest mp4 at or
                below 720p ourselves keeps the same look at a fraction of
                the bytes (and decode work). Falls back to plain video_tag
                if the file has no mp4 rendition in range.
              {% endcomment %}
              {% liquid
                assign hero_video = block.settings.video
                assign hero_source = nil
                for source in hero_video.sources
                  if source.format == 'mp4' and source.height <= 720
                    if hero_source == nil or source.height > hero_source.height
                      assign hero_source = source
                    endif
                  endif
                endfor
              %}

              {% if forloop.first %}
                {% comment %}
                  fetchpriority="high" — this is the LCP element on the
                  homepage, but video_tag doesn't accept fetchpriority as
                  a filter parameter (unlike image_tag, which does), so
                  it's injected into the generated markup directly. Same
                  post-processing approach already used below for the
                  deferred slides' src -> data-src swap.
                {% endcomment %}
                {% capture eager_hero_video %}
                  {% if hero_source %}
                    <video class="j-hero__video"
                      poster="{{ hero_video.preview_image | image_url: width: 1000 }}"
                      preload="metadata"
                      muted="muted"
                      loop="loop"
                      playsinline="true"
                      autoplay="autoplay"
                    ><source src="{{ hero_source.url }}" type="{{ hero_source.mime_type }}"></video>
                  {% else %}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '1200x',
                        class: 'j-hero__video',
                        muted: true,
                        loop: true,
                        playsinline: true,
                        autoplay: true
                    }}
                  {% endif %}
                {% endcapture %}
                {% comment %}
                  On a <video>, fetchpriority applies to the video file, not
                  to its poster — and the poster is what actually paints as
                  the LCP element. Preloading the exact poster URL that
                  video_tag generated (extracted from its output so the two
                  can never drift apart) makes it a high-priority request
                  discoverable straight from the HTML. (AssetPreload's suggested
                  image_tag preload argument doesn't apply to a video poster.)
                {% endcomment %}
                {% if eager_hero_video contains ' poster="' %}
                  {% assign hero_poster_url = eager_hero_video | split: ' poster="' | last | split: '"' | first %}
                  {% # theme-check-disable AssetPreload %}
                  <link rel="preload" as="image" href="{{ hero_poster_url }}" fetchpriority="high">
                  {% # theme-check-enable AssetPreload %}
                {% endif %}
                {{ eager_hero_video | replace: '<video ', '<video fetchpriority="high" ' }}
              {% else %}
                {% capture deferred_hero_video %}
                  {% if hero_source %}
                    <video class="j-hero__video"
                      poster="{{ hero_video.preview_image | image_url: width: 1000 }}"
                      preload="metadata"
                      muted="muted"
                      loop="loop"
                      playsinline="true"
                    ><source src="{{ hero_source.url }}" type="{{ hero_source.mime_type }}"></video>
                  {% else %}
                    {{
                      block.settings.video
                      | video_tag:
                        image_size: '1200x',
                        class: 'j-hero__video',
                        muted: true,
                        loop: true,
                        playsinline: true
                    }}
                  {% endif %}
                {% endcapture %}
                {{ deferred_hero_video | replace: ' src=', ' data-src=' }}
              {% endif %}

            {% elsif block.settings.image %}
              {% if forloop.first %}
                {% assign img_alt = block.settings.heading | default: shop.name %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'eager',
                    fetchpriority: 'high',
                    widths: '360, 480, 600, 760, 1000, 1200',
                    sizes: '(max-width: 991px) 90vw, 560px',
                    class: 'j-hero__img',
                    alt: img_alt
                }}
              {% else %}
                {% comment %}
                  Every slide sits at position: absolute; inset: 0 from
                  first paint (see hero.css), all overlapping the same
                  viewport-visible box the active slide occupies — so
                  loading="lazy" never defers them; the browser considers
                  them "in view" immediately and fetches all N slide images
                  upfront. Withholding src/srcset (via data-src/data-srcset)
                  until hero-slideshow.js hydrates them on idle avoids
                  downloading slides the visitor may never scroll to.
                {% endcomment %}
                {% capture deferred_hero_image %}
                  {% assign img_alt = block.settings.heading | default: shop.name %}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '360, 480, 600, 760, 1000, 1200',
                      sizes: '(max-width: 991px) 90vw, 560px',
                      class: 'j-hero__img',
                      alt: img_alt
                  }}
                {% endcapture %}
                {{ deferred_hero_image | replace: ' src=', ' data-src=' | replace: ' srcset=', ' data-srcset=' }}
              {% endif %}
            {% else %}
              <div class="j-hero__placeholder">
                {{ 'lifestyle-1' | placeholder_svg_tag: 'j-hero__placeholder-svg' }}
              </div>
            {% endif %}

          </div>

          {% if slide_blocks.size > 1 %}
            <div class="j-hero-slideshow__arrows">
              <button
                type="button"
                class="j-hero-slideshow__arrow j-hero-slideshow__arrow--prev"
                aria-label="{{ 'general.pagination.prev' | t }}"
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>

              <button
                type="button"
                class="j-hero-slideshow__arrow j-hero-slideshow__arrow--next"
                aria-label="{{ 'general.pagination.next' | t }}"
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M7.5 5 12.5 10l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          {% endif %}

        </div>
      {% endfor %}
    </div>

  </div>

  {% comment %}
    Curved divider into Shop by Category — the hero (a dark video/photo)
    used to cut off abruptly into that section's light purple gradient
    background with a hard flat seam. This wave shape, filled with a
    color sampled from that gradient's lighter stop, sits on top of the
    hero's own bottom edge so it reads as the next section flowing up
    into it, instead of two unrelated blocks just stacked on top of each
    other. Purely decorative (aria-hidden) and never intercepts clicks
    on the arrows/content above it.
  {% endcomment %}
  <svg class="j-hero-band__divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    {% comment %}
      A flat fill color only matches Shop by Category's actual
      background (a 135deg diagonal gradient — see .j-shop-by-category
      in shop-by-category.css) at one single point along that diagonal,
      so it looked visibly mismatched everywhere else the wave crossed.
      This gradient definition mirrors those same three stops/direction,
      so the wave continues the real background instead of an
      approximation of it.
    {% endcomment %}
    <defs>
      <linearGradient id="heroDividerGradient-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#f3effa"/>
        <stop offset="50%" stop-color="#d9c9f0"/>
        <stop offset="100%" stop-color="#ece2f7"/>
      </linearGradient>
    </defs>
    <path d="M0,40 C240,90 480,0 720,20 C960,40 1200,90 1440,30 L1440,80 L0,80 Z" fill="url(#heroDividerGradient-{{ section.id }})"/>
  </svg>

</div>

{% schema %}
{
  "name": "Slideshow",
  "settings": [
    {
      "type": "font_picker",
      "id": "button_font",
      "label": "Button font",
      "default": "bebas_neue_n4"
    },
    {
      "type": "font_picker",
      "id": "trust_font",
      "label": "Trust row font",
      "default": "instrument_serif_n4"
    },
    {
      "type": "font_picker",
      "id": "description_font",
      "label": "Description font",
      "default": "rajdhani_n4"
    },
    {
      "type": "font_picker",
      "id": "badge_font",
      "label": "Badge font",
      "default": "unifraktur_maguntia_n4"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Ignored if a video is set below."
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Plays muted and looping. Overrides the image when set."
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Premium Lifestyle Collection"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Discover Your"
        },
        {
          "type": "text",
          "id": "highlight_heading",
          "label": "Highlighted Heading",
          "default": "Next Favorite"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Carefully selected products crafted for modern living. Simple. Elegant. Timeless."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Primary button label",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Primary button link"
        },
        {
          "type": "text",
          "id": "secondary_label",
          "label": "Secondary button label",
          "default": "Explore"
        },
        {
          "type": "url",
          "id": "secondary_link",
          "label": "Secondary button link"
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure" },
            { "value": "quality", "label": "Quality" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free Shipping"
        }
      ]
    }
  ],
  "max_blocks": 7,
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        { "type": "slide" },
        {
          "type": "trust_item",
          "settings": { "icon": "shipping", "text": "Free Shipping" }
        },
        {
          "type": "trust_item",
          "settings": { "icon": "returns", "text": "Easy Returns" }
        },
        {
          "type": "trust_item",
          "settings": { "icon": "secure", "text": "Secure Checkout" }
        }
      ]
    }
  ]
}
{% endschema %}
