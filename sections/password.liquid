{% comment %}
  This section is used in the password template to render landing page shown
  when password protection is applied to a store.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

{% if settings.logo %}
  {{
    settings.logo
    | image_url: width: 300
    | image_tag: alt: shop.name, widths: '150, 300, 450, 600', sizes: '300px'
  }}
{% else %}
  <p class="j-password__shop-name">{{ shop.name }}</p>
{% endif %}

<h1>{{ 'password.title' | t }}</h1>

{% if shop.password_message %}
  <p>{{ shop.password_message }}</p>
{% endif %}

{% form 'storefront_password' %}
  {% if form.errors %}
    {{ form.errors | default_errors }}
  {% endif %}

  <label for="password-input">
    {{ 'password.password' | t }}
  </label>

  <input type="password" name="password" id="password-input">

  <button type="submit">
    {{ 'password.enter' | t }}
  </button>
{% endform %}

{% comment %}
  Must render bare/unaltered — Shopify's own required password-page link,
  not to be wrapped with extra text or restyled to change its content.
{% endcomment %}
{{ powered_by_link }}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
