<div class="j-cart-drawer" id="CartDrawer">

  <div class="j-cart-overlay"></div>

  <aside class="j-cart" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">

    <!-- Header -->
    <div class="j-cart__header">

      <h2 id="CartDrawerTitle">{{ 'cart.drawer_title' | t }}</h2>

      <button
        type="button"
        class="j-cart__close"
        aria-label="{{ 'cart.close' | t }}"
      >
        ×
      </button>

    </div>

    <!-- Cart Items -->
    <div class="j-cart__body">

      <div
        class="j-cart-items"
        data-continue-shopping-url="{{ routes.all_products_collection_url }}"
      >
        {% if cart.item_count == 0 %}
          <p class="j-cart__empty">
            {{ 'cart.empty' | t }}
          </p>
          <a href="{{ routes.all_products_collection_url }}" class="j-button j-cart__continue">
            {{ 'cart.continue_shopping' | t }}
          </a>
        {% else %}
          {% for item in cart.items %}
            {% render 'cart-item', item: item %}
          {% endfor %}
        {% endif %}
      </div>

    </div>

    <!-- Footer -->
    <div class="j-cart__footer">

      <div class="j-cart__subtotal">

        <span>{{ 'cart.subtotal' | t }}</span>

        <strong class="j-cart-subtotal-value">
          {{ cart.total_price | money }}
        </strong>

      </div>

      {% unless template.name == 'cart' %}
        <a
          href="{{ routes.cart_url }}"
          class="j-button j-button-outline j-cart-view-link {% if cart.item_count == 0 %}is-disabled{% endif %}"
          {% if cart.item_count == 0 %}
            aria-disabled="true"
            tabindex="-1"
          {% endif %}
        >
          {{ 'cart.view_cart' | t }}
        </a>
      {% endunless %}

      {% form 'cart', cart %}
        <input
          type="submit"
          name="checkout"
          class="j-button j-cart-checkout-button"
          value="{{ 'cart.checkout' | t }}"
          {% if cart.item_count == 0 %}disabled{% endif %}
        >

        {% if cart.item_count > 0 %}
          {{ form | payment_button }}
        {% endif %}
      {% endform %}

    </div>

  </aside>

</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}