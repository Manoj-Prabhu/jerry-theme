<div class="j-cart-drawer" id="CartDrawer">

  <div class="j-cart-overlay"></div>

  <aside class="j-cart" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle">

    <!-- Header -->
    <div class="j-cart__header">

      <h2 id="CartDrawerTitle">{{ 'cart.drawer_title' | t }}</h2>

      <button
        type="button"
        class="j-cart__close"
        aria-label="{{ 'cart.close' | t }}"
      >
        ×
      </button>

    </div>

    <!-- Cart Items -->
    <div class="j-cart__body">

      {% liquid
        assign suggested_collection = collections[section.settings.empty_cart_collection]

        # Falls back to the first non-empty collection when no collection
        # is chosen in the section settings (or the chosen one no longer
        # exists) — this card should always have something to show, not
        # depend on that being configured.
        if suggested_collection == blank
          for c in collections
            if c.products.size > 0
              assign suggested_collection = c
              break
            endif
          endfor
        endif
      %}

      <div
        class="j-cart-items"
        data-continue-shopping-url="{{ routes.all_products_collection_url }}"
        {% if suggested_collection != blank %}
          data-suggestion-heading="{{ section.settings.empty_cart_heading }}"
          data-suggestion-url="{{ suggested_collection.url }}"
          data-suggestion-title="{{ suggested_collection.title | escape }}"
          data-suggestion-image="{{ suggested_collection.featured_image | image_url: width: 480 }}"
        {% endif %}
      >
        {% if cart.item_count == 0 %}
          <div class="j-cart__empty-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M6 8h12l-1.2 11.2a2 2 0 0 1-2 1.8H9.2a2 2 0 0 1-2-1.8L6 8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </div>
          <p class="j-cart__empty">
            {{ 'cart.empty' | t }}
          </p>
          <a href="{{ routes.all_products_collection_url }}" class="j-button j-button-outline--gold j-cart__continue">
            {{ 'cart.continue_shopping' | t }}
          </a>

          {% if suggested_collection != blank %}
            <div class="j-cart__suggestion">
              <p class="j-cart__suggestion-heading">{{ section.settings.empty_cart_heading }}</p>
              <a href="{{ suggested_collection.url }}" class="j-cart__suggestion-card">
                {% if suggested_collection.featured_image != blank %}
                  {{
                    suggested_collection.featured_image
                    | image_url: width: 480
                    | image_tag: loading: 'lazy', widths: '240, 360, 480', class: 'j-cart__suggestion-image', alt: ''
                  }}
                {% else %}
                  <div class="j-cart__suggestion-placeholder">{{ 'collection' | placeholder_svg_tag: 'j-cart__suggestion-placeholder-svg' }}</div>
                {% endif %}
                <span class="j-cart__suggestion-title">{{ suggested_collection.title }}</span>
              </a>
            </div>
          {% endif %}
        {% else %}
          {% for item in cart.items %}
            {% render 'cart-item', item: item %}
          {% endfor %}
        {% endif %}
      </div>

    </div>

    <!-- Footer -->
    <div class="j-cart__footer">

      <div class="j-cart__subtotal">

        <span>{{ 'cart.subtotal' | t }}</span>

        <strong class="j-cart-subtotal-value">
          {{ cart.total_price | money }}
        </strong>

      </div>

      {% unless template.name == 'cart' %}
        <a
          href="{{ routes.cart_url }}"
          class="j-button j-button-outline j-cart-view-link {% if cart.item_count == 0 %}is-disabled{% endif %}"
          {% if cart.item_count == 0 %}
            aria-disabled="true"
            tabindex="-1"
          {% endif %}
        >
          {{ 'cart.view_cart' | t }}
        </a>
      {% endunless %}

      {% form 'cart', cart %}
        {% if cart.item_count > 0 %}
          <div class="j-cart-page__note-field">
            <label for="CartDrawerNote">{{ 'cart.notes' | t }}</label>
            <textarea
              id="CartDrawerNote"
              name="note"
              placeholder="{{ 'cart.notes_placeholder' | t }}"
            >{{ cart.note }}</textarea>
          </div>
        {% endif %}

        <input
          type="submit"
          name="checkout"
          class="j-button j-cart-checkout-button"
          value="{{ 'cart.checkout' | t }}"
          {% if cart.item_count == 0 %}disabled{% endif %}
        >

        {% if cart.item_count > 0 %}
          <div style="--shopify-payment-button-color-scheme: dark;">
            {{ form | payment_button }}
          </div>
        {% endif %}
      {% endform %}

    </div>

  </aside>

</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": [
    {
      "type": "text",
      "id": "empty_cart_heading",
      "label": "Empty cart suggestion heading",
      "default": "You should definitely check out"
    },
    {
      "type": "collection",
      "id": "empty_cart_collection",
      "label": "Empty cart suggested collection",
      "info": "Shown as an image card below \"Continue Shopping\" when the cart is empty."
    }
  ]
}
{% endschema %}