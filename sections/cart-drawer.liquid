<div class="j-cart-drawer" id="CartDrawer">

  <div class="j-cart-overlay"></div>

  <aside class="j-cart">

    <!-- Header -->
    <div class="j-cart__header">

      <h2>Your Cart</h2>

      <button
        type="button"
        class="j-cart__close"
        aria-label="Close cart"
      >
        ×
      </button>

    </div>

    <!-- Cart Items -->
    <div class="j-cart__body">

      <div
        class="j-cart-items"
        data-continue-shopping-url="{{ routes.all_products_collection_url }}"
      ></div>

    </div>

    <!-- Footer -->
    <div class="j-cart__footer">

      <div class="j-cart__subtotal">

        <span>Subtotal</span>

        <strong class="j-cart-subtotal-value">
          {{ cart.total_price | money }}
        </strong>

      </div>

      {% unless template.name == 'cart' %}
        <a
          href="{{ routes.cart_url }}"
          class="j-button j-button-outline j-cart-view-link {% if cart.item_count == 0 %}is-disabled{% endif %}"
          {% if cart.item_count == 0 %}
            aria-disabled="true"
            tabindex="-1"
          {% endif %}
        >
          View Cart
        </a>
      {% endunless %}

      <form action="{{ routes.cart_url }}" method="post">
        <input
          type="submit"
          name="checkout"
          class="j-button j-cart-checkout-button"
          value="{{ 'cart.checkout' | t }}"
          {% if cart.item_count == 0 %}disabled{% endif %}
        >
      </form>

    </div>

  </aside>

</div>

{% schema %}
{
  "name": "Cart Drawer",
  "settings": []
}
{% endschema %}