{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <header class="j-blog__header">
      <h1>{{ blog.title }}</h1>

      {% if blog.articles_count > 0 %}
        <p>{{ blog.articles_count }} Articles</p>
      {% endif %}
    </header>
  </div>
</div>

<div class="j-blog page-width">

  {% paginate blog.articles by 6 %}

    <div class="j-blog__grid">

      {% for article in blog.articles %}

        <article class="j-blog-card">

          <a href="{{ article.url }}">

            {% if article.image %}

              <div class="j-blog-card__image">

                {{
                  article.image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    alt: article.image.alt | default: article.title
                }}

                <span class="j-blog-card__date">
                  <strong>{{ article.published_at | date: "%d" }}</strong>
                  {{ article.published_at | date: "%b" }}
                </span>

              </div>

            {% endif %}

            <div class="j-blog-card__content">

              <p class="j-blog-card__meta">
                {{ article.published_at | date: "%B %d, %Y" }}
                {% if article.author %}
                  · {{ article.author }}
                {% endif %}
              </p>

              <h2>{{ article.title }}</h2>

              <p class="j-blog-card__excerpt">
                {{ article.excerpt_or_content | strip_html | truncate: 120 }}
              </p>

              <span class="j-blog-card__link">
                Read Article
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>

            </div>

          </a>

        </article>

      {% endfor %}

    </div>

    {% if paginate.pages > 1 %}

      <div class="j-pagination">

        {{ paginate | default_pagination }}

      </div>

    {% endif %}

  {% endpaginate %}

</div>

{% schema %}
{
  "name": "Main Blog",
  "settings": []
}
{% endschema %}