{% # theme-check-disable AssetPreload %}
{% comment %}
  This section's content is entirely populated by JS after load (reading
  localStorage, then fetching each product) — nothing above the fold
  depends on this CSS, so it's loaded without blocking render.
{% endcomment %}
<link rel="preload" href="{{ 'recently-viewed.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript>{{ 'recently-viewed.css' | asset_url | stylesheet_tag }}</noscript>
{% # theme-check-enable AssetPreload %}

<div class="j-recently-viewed">

  <h2 class="j-section-title">
    {{ 'product.recently_viewed_title' | t }}
  </h2>

  <div
    class="j-product-grid"
    id="RecentlyViewedProducts"
  >
    {% comment %}
      This grid starts empty and is filled by recently-viewed.js after it
      reads localStorage and fetches each product — these skeleton cards
      cover that gap instead of a blank grid under the heading; the JS
      overwrites this element's contents wholesale once it has an answer.
    {% endcomment %}
    {% render 'product-grid-skeleton', count: 4 %}
  </div>

</div>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Recently viewed products",
  "settings": []
}
{% endschema %}