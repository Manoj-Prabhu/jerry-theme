{% comment %}
  This section's content is entirely populated by JS after load (reading
  localStorage, then fetching each product) — nothing above the fold
  depends on this CSS, so it's loaded without blocking render.
{% endcomment %}
<link rel="stylesheet" href="{{ 'recently-viewed.css' | asset_url }}" media="print" onload="this.onload=null;this.media='all'">
<noscript>{{ 'recently-viewed.css' | asset_url | stylesheet_tag }}</noscript>

{% comment %}
  Starts hidden (outside the theme editor) and is only revealed by the
  inline script below, before first paint, when this visitor actually
  has other products in their history. It used to always render four
  tall skeleton cards and then, for anyone with no history — every
  first-time visitor — swap them for one line of text, collapsing the
  section by several hundred pixels after load and shifting everything
  beneath it (a 0.12 layout shift in Lighthouse).
{% endcomment %}
<div class="j-recently-viewed"{% unless request.design_mode %} hidden{% endunless %}>

  <h2 class="j-section-title">
    {{ 'product.recently_viewed_title' | t }}
  </h2>

  <div
    class="j-product-grid"
    id="RecentlyViewedProducts"
  >
    {% comment %}
      This grid starts empty and is filled by recently-viewed.js after it
      reads localStorage and fetches each product — these skeleton cards
      cover that gap instead of a blank grid under the heading; the JS
      overwrites this element's contents wholesale once it has an answer.
    {% endcomment %}
    {% render 'product-grid-skeleton', count: 4 %}
  </div>

</div>

<script>
  (function () {
    var section = document.currentScript.previousElementSibling;
    try {
      var current = decodeURIComponent((location.pathname.split('/products/')[1] || '').split('/')[0]);
      var handles = JSON.parse(localStorage.getItem('jerry-recently-viewed')) || [];
      for (var i = 0; i < handles.length; i++) {
        if (handles[i] !== current) {
          section.hidden = false;
          break;
        }
      }
    } catch (error) {
      /* localStorage unavailable — leave the section hidden */
    }
  })();
</script>

<script src="{{ 'recently-viewed.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Recently viewed products",
  "settings": []
}
{% endschema %}