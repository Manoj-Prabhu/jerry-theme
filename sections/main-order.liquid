{% comment %}
  Customer Order Detail
{% endcomment %}

{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <div class="j-account__header">
      <h1>{{ 'customers.order.title_html' | t: name: order.name }}</h1>
      <a href="{{ routes.account_url }}" class="j-account__link">
        {{ 'customers.order.back_to_account' | t }}
      </a>
    </div>
  </div>
</div>

<div class="page-width j-account">

  <p class="j-account__subtext">
    {{ 'customers.order.date_html' | t: date: order.created_at | date: format: 'abbreviated_date' }}
  </p>

  {% if order.cancelled %}
    <p class="j-account__order-cancelled">
      {{ 'customers.order.cancelled_html' | t: date: order.cancelled_at | date: format: 'abbreviated_date' }}
      {% if order.cancel_reason_label %}
        — {{ 'customers.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
      {% endif %}
    </p>
  {% endif %}

  <div class="j-account__order-addresses">

    {% if order.billing_address %}
      <div class="j-account__order-address">
        <h3>{{ 'customers.order.billing_address' | t }}</h3>
        {{ order.billing_address | format_address }}
      </div>
    {% endif %}

    {% if order.shipping_address %}
      <div class="j-account__order-address">
        <h3>{{ 'customers.order.shipping_address' | t }}</h3>
        {{ order.shipping_address | format_address }}
      </div>
    {% endif %}

  </div>

  <div class="j-account__table-wrapper">
    <table class="j-account__table">
      <thead>
        <tr>
          <th>{{ 'customers.order.product' | t }}</th>
          <th>{{ 'customers.order.sku' | t }}</th>
          <th>{{ 'customers.order.price' | t }}</th>
          <th>{{ 'customers.order.quantity' | t }}</th>
          <th>{{ 'customers.order.total' | t }}</th>
        </tr>
      </thead>
      <tbody>
        {% for line_item in order.line_items %}
          <tr>
            <td>
              {% if line_item.product %}
                <a href="{{ line_item.product.url }}">{{ line_item.title }}</a>
              {% else %}
                {{ line_item.title }}
              {% endif %}
              {% if line_item.variant.title != 'Default Title' %}
                <br>
                <small>{{ line_item.variant.title }}</small>
              {% endif %}
            </td>
            <td>{{ line_item.sku }}</td>
            <td>{{ line_item.original_price | money }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
      <tfoot>
        <tr>
          <td colspan="4">{{ 'customers.order.subtotal' | t }}</td>
          <td>{{ order.line_items_subtotal_price | money }}</td>
        </tr>

        {% for discount in order.cart_level_discount_applications %}
          <tr>
            <td colspan="4">{{ discount.title }} ({{ 'customers.order.discount' | t }})</td>
            <td>-{{ discount.total_allocated_amount | money }}</td>
          </tr>
        {% endfor %}

        {% for shipping_line in order.shipping_lines %}
          <tr>
            <td colspan="4">{{ 'customers.order.shipping' | t }} ({{ shipping_line.title }})</td>
            <td>{{ shipping_line.price | money }}</td>
          </tr>
        {% endfor %}

        {% for tax_line in order.tax_lines %}
          <tr>
            <td colspan="4">
              {{ 'customers.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)
            </td>
            <td>{{ tax_line.price | money }}</td>
          </tr>
        {% endfor %}

        <tr class="j-account__table-total">
          <td colspan="4">{{ 'customers.order.total' | t }}</td>
          <td>{{ order.total_price | money }}</td>
        </tr>
      </tfoot>
    </table>
  </div>

</div>

{% schema %}
{
  "name": "Customer order",
  "settings": []
}
{% endschema %}
