{% liquid
  assign selected_collection = section.settings.collection
  assign has_products = false
  if selected_collection != blank and selected_collection.products_count > 0
    assign has_products = true
  endif
%}

{% comment %}
  Renders nothing at all on the live storefront when there's no usable
  content — either no collection picked, or one picked that currently
  has zero products (a real merchant scenario: a brand-new "editors
  picks" collection created but not yet populated). Previously this
  rendered the section's heading/View All chrome around an empty
  product grid either way, leaving a bare heading over a blank gap for
  real shoppers. The "pick a collection" nudge is only useful to a
  merchant mid-setup, so it's gated to the theme editor (request.
  design_mode) instead of showing raw setup instructions to customers.
{% endcomment %}
{% if has_products or request.design_mode %}
  <section class="j-featured-collection">
    <div class="j-featured-collection__heading">
      <h2>{{ section.settings.heading }}</h2>
      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}
    </div>

    {% if has_products %}
      <div class="j-product-grid">
        {% for product in selected_collection.products limit: section.settings.products_to_show %}
          {%- comment -%}
            Only one image per page should carry fetchpriority="high". The
            first card gets it only when this section opens the page;
            anywhere lower, the hero or main product image is the LCP.
          {%- endcomment -%}
          {%- liquid
            assign card_priority = false
            assign card_eager = false
            if forloop.index <= 4
              assign card_eager = true
              if forloop.first
                assign card_priority = true
              endif
            endif
            # A positive "not at the top" test: section.index is nil in the
            # editor and Section Rendering API, which stays on the eager side.
            if section.index > 1 or section.location == 'footer'
              assign card_eager = false
              assign card_priority = false
            endif
          -%}
          {% render 'product-card', product: product, priority: card_priority, eager: card_eager, sizes: '(max-width: 700px) 80vw, (max-width: 1200px) 42vw, 520px' %}
        {% endfor %}
      </div>

      <div class="j-featured-collection__view-all">
        <a href="{{ selected_collection.url }}" class="j-button j-button-outline">
          {{ 'general.view_all' | t }}
          <svg class="j-featured-collection__view-all-arrow" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

    {% elsif selected_collection != blank %}
      <p style="text-align:center;">
        The "{{ selected_collection.title }}" collection has no products yet.
      </p>
    {% else %}
      <p style="text-align:center;">
        Select a collection in the Theme Editor.
      </p>
    {% endif %}

  </section>
{% endif %}

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Collection"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover our latest curated products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}