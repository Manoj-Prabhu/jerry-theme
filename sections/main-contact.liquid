{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <div class="j-contact__header">

      <h1>{{ page.title }}</h1>

      {% if page.content != blank %}
        <div class="j-contact__intro">
          {{ page.content }}
        </div>
      {% endif %}

    </div>
  </div>
</div>

<div class="j-contact page-width">

  <div class="j-contact__layout">

    <div class="j-contact__aside">

      <h2>Let's start a conversation</h2>

      <p>
        Have a question about an order, a product, or anything else?
        Send us a message and our team will get back to you shortly.
      </p>

      <ul class="j-contact__highlights">

        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 5.5v5l3.5 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="10" cy="10" r="7" stroke="currentColor" stroke-width="1.5"/>
          </svg>
          Fast response times
        </li>

        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10.5 8 14.5 16 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Friendly, knowledgeable support
        </li>

        <li>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 2 3 5.5v4c0 4.5 3 7 7 8.5 4-1.5 7-4 7-8.5v-4L10 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
          </svg>
          Here to help every step of the way
        </li>

      </ul>

    </div>

    <div class="j-contact__form">

      {% form 'contact' %}

        {% if form.posted_successfully? %}
          <p class="j-contact__success">
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10.5 8 14.5 16 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ 'contact.success' | t }}
          </p>
        {% endif %}

        {{ form.errors | default_errors }}

        <div class="j-contact__field">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M10 10a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm0 1.5c-3 0-6.5 1.5-6.5 4.5v.5h13v-.5c0-3-3.5-4.5-6.5-4.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
          <label for="ContactName" class="visually-hidden">{{ 'contact.name' | t }}</label>
          <input
            type="text"
            id="ContactName"
            name="contact[name]"
            placeholder="{{ 'contact.name' | t }}"
            required
          >
        </div>

        <div class="j-contact__field">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <rect x="2.5" y="4.5" width="15" height="11" rx="2" stroke="currentColor" stroke-width="1.3"/>
            <path d="m3 5.5 7 5.5 7-5.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <label for="ContactEmail" class="visually-hidden">{{ 'contact.email' | t }}</label>
          <input
            type="email"
            id="ContactEmail"
            name="contact[email]"
            placeholder="{{ 'contact.email' | t }}"
            required
          >
        </div>

        <div class="j-contact__field">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 3h2.2l1 3.6-1.6 1.4a9 9 0 0 0 4.4 4.4l1.4-1.6 3.6 1v2.2c0 1-.8 1.8-1.8 1.7A13.5 13.5 0 0 1 3.3 4.8C3.2 3.8 4 3 5 3Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
          <label for="ContactPhone" class="visually-hidden">{{ 'contact.phone' | t }}</label>
          <input
            type="tel"
            id="ContactPhone"
            name="contact[phone]"
            placeholder="{{ 'contact.phone' | t }}"
          >
        </div>

        <div class="j-contact__field j-contact__field--textarea">
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 5.5A1.5 1.5 0 0 1 4.5 4h11A1.5 1.5 0 0 1 17 5.5v6A1.5 1.5 0 0 1 15.5 13H8l-3.5 3v-3H4.5A1.5 1.5 0 0 1 3 11.5v-6Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
          </svg>
          <label for="ContactMessage" class="visually-hidden">{{ 'contact.message' | t }}</label>
          <textarea
            id="ContactMessage"
            name="contact[body]"
            rows="6"
            placeholder="{{ 'contact.message' | t }}"
            required
          ></textarea>
        </div>

        <button
          type="submit"
          class="j-button j-contact__submit"
        >
          {{ 'contact.submit' | t }}
        </button>

      {% endform %}

    </div>

  </div>

</div>

{% schema %}
{
  "name": "Main Contact",
  "settings": []
}
{% endschema %}