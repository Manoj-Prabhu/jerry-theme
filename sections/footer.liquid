{% assign menu_blocks = section.blocks | where: 'type', 'menu' %}
{% assign has_menus = false %}
{% for block in menu_blocks %}
  {% if block.settings.menu.links.size > 0 %}
    {% assign has_menus = true %}
  {% endif %}
{% endfor %}

{% style %}
  /* Same reasoning as the hero's divider (see sections/hero.liquid) —
     the true color a short/flat seam-line gradient should show depends
     on the actual box it's approximating, and the footer is a much
     narrower, differently-proportioned box on mobile (menus stack
     vertically, so it's far taller relative to its width there) than on
     desktop, so the ramp needs a smaller mobile-only reach. */
  @media (max-width: 480px) {
    #footerDividerGradient-{{ section.id }} stop:nth-child(2) {
      stop-color: #f9f3e5;
    }
  }
{% endstyle %}

<footer class="j-footer full-width">

  {% comment %}
    Curved divider into the footer — the same technique as the hero's
    own wave into Shop by Category (see sections/hero.liquid): a wave
    filled with a gradient approximating the footer's actual background
    color along this seam, so it reads as the footer flowing up over
    whatever section precedes it instead of a flat straight line seam.
  {% endcomment %}
  <svg class="j-footer__divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="footerDividerGradient-{{ section.id }}" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="#f5ecd7"/>
        <stop offset="100%" stop-color="#fdfbf6"/>
      </linearGradient>
    </defs>
    <path
      d="M0,52 C240,24 480,24 720,46 C960,68 1200,68 1440,42 L1440,80 L0,80 Z"
      fill="url(#footerDividerGradient-{{ section.id }})"
    />
  </svg>

  <div class="j-footer__container {% unless has_menus %}j-footer__container--no-menus{% endunless %}">

    <div class="j-footer__column j-footer__column--brand">
      <h3 class="j-footer__logo">{{ shop.name }}</h3>
      <span class="j-footer__logo-rule" aria-hidden="true"></span>
      <p>
        {{ section.settings.description }}
      </p>
    </div>

    {% if has_menus %}
      <div class="j-footer__menus">

        {% for block in menu_blocks %}
          {% if block.settings.menu.links.size > 0 %}
            <div class="j-footer__column" {{ block.shopify_attributes }}>
              <h4>{{ block.settings.menu.title }}</h4>

              <ul>
                {% for link in block.settings.menu.links %}
                  <li>
                    <a href="{{ link.url }}">{{ link.title }}</a>
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}

      </div>
    {% endif %}

    <div class="j-footer__column j-footer__column--newsletter">
      {% comment %}
        The Rive mascot previously only ever appeared in Quick View and
        the 404 page — two places almost nobody looks, for what's
        otherwise the theme's most distinctive visual asset. This gives
        it a small, ambient home on every page's footer instead, without
        adding weight to page load: assets/footer-mascot.js only fetches
        the Rive runtime once this canvas actually scrolls into view
        (same lazy pattern already used for Quick View/404), not on
        initial load.
      {% endcomment %}
      <canvas class="j-footer__mascot" id="FooterMascotCanvas" width="72" height="72" aria-hidden="true"></canvas>

      <h4>{{ 'footer.newsletter_title' | t }}</h4>
      <p class="j-footer__newsletter-copy">{{ 'footer.newsletter_subtext' | t }}</p>

      {% form 'customer', class: 'j-footer__newsletter' %}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        {% if form.posted_successfully? %}
          <p class="j-footer__form-message j-footer__form-message--success">{{ 'footer.subscribe_success' | t }}</p>
        {% elsif form.errors %}
          <p class="j-footer__form-message j-footer__form-message--error">
            {% if form.errors.messages['email'] %}
              {{ form.errors.messages['email'] }}
            {% else %}
              {{ 'footer.subscribe_error' | t }}
            {% endif %}
          </p>
        {% endif %}

        <div class="j-footer__newsletter-field">
          <label for="footer-newsletter-email" class="visually-hidden">{{ 'footer.email_label' | t }}</label>
          <input
            id="footer-newsletter-email"
            type="email"
            name="contact[email]"
            placeholder="{{ 'footer.email_placeholder' | t }}"
            autocomplete="email"
            required
          >
          <button
            type="submit"
            class="j-footer__newsletter-submit"
          >
            <span>{{ 'footer.subscribe' | t }}</span>
            <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M4 10h12M11 5l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {% endform %}

      <p class="j-footer__newsletter-trust">{{ 'footer.newsletter_trust' | t }}</p>
    </div>
  </div>

  {% if section.settings.show_localization_selector %}
    <div class="j-footer__localization">
      {% render 'localization' %}
    </div>
  {% endif %}

  <div class="j-footer__meta">

      {% if section.settings.show_social_icons %}
        <div class="j-footer__social">
          {% if settings.facebook != blank %}
            <a href="{{ settings.facebook }}" class="j-footer__social-link" aria-label="Facebook" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 8.5h2V5.5h-2c-2.2 0-4 1.8-4 4v2H9v3h2v7h3v-7h2.2l.8-3H14v-2c0-.6.4-1 1-1z" fill="currentColor"/></svg>
            </a>
          {% endif %}

          {% if settings.instagram != blank %}
            <a href="{{ settings.instagram }}" class="j-footer__social-link" aria-label="Instagram" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg>
            </a>
          {% endif %}

          {% if settings.x != blank %}
            <a href="{{ settings.x }}" class="j-footer__social-link" aria-label="X" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            </a>
          {% endif %}

          {% if settings.youtube != blank %}
            <a href="{{ settings.youtube }}" class="j-footer__social-link" aria-label="YouTube" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="6" width="19" height="12" rx="3" stroke="currentColor" stroke-width="1.6"/><path d="M10.5 9.5v5l4.5-2.5-4.5-2.5z" fill="currentColor"/></svg>
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% comment %} Shop app follow button — colors/markup are managed by Shopify and must not be restyled. {% endcomment %}
      <div class="j-footer__follow-on-shop">
        {{ shop | login_button: action: 'follow' }}
      </div>

      {% if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 %}
        <div class="j-footer__payment">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'j-footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}

      <p class="j-footer__copyright">
        © {{ 'now' | date: '%Y' }}
        {{ shop.name }}
        •
        {{ 'footer.rights_reserved' | t }}
      </p>

  </div>

  <div class="j-footer__blocks">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'custom_liquid' %}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.custom_liquid }}
          </div>
        {% when '@app' %}
          {% render block %}
      {% endcase %}
    {% endfor %}
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium products crafted for modern living."
    },
    {
      "type": "checkbox",
      "id": "show_social_icons",
      "label": "Show social media icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_localization_selector",
      "label": "Show country/currency selector",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer menu",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Footer menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid code",
          "info": "Add app snippets, custom HTML, or third-party embed code."
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" },
        { "type": "menu" },
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
