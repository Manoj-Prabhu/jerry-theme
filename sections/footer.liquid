<footer class="j-footer full-width">

  <div class="j-footer__container">

    <div class="j-footer__column">
      <h3>{{ shop.name }}</h3>
      <p>
        {{ section.settings.description }}
      </p>
    </div>

    <div class="j-footer__column">
      <h4>Quick Links</h4>

      <ul>
        {% for link in section.settings.quick_links.links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="j-footer__column">
      <h4>Customer</h4>

      <ul>
        {% for link in section.settings.customer_links.links %}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
          </li>
        {% endfor %}
      </ul>
    </div>

    <div class="j-footer__column">
      <h4>Newsletter</h4>
      {% form 'customer', class: 'j-footer__newsletter' %}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >
        <input
          type="email"
          name="contact[email]"
          placeholder="Enter your email"
          required
        >
        <button
          type="submit"
          class="j-button"
        >
          Subscribe
        </button>
      {% endform %}
    </div>
  </div>

  <div class="j-footer__bottom">
    <p>
      © {{ 'now' | date: '%Y' }}
      {{ shop.name }}.
      All rights reserved.
    </p>
  </div>

</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Premium products crafted for modern living."
    },
    {
      "type": "link_list",
      "id": "quick_links",
      "label": "Quick Links"
    },
    {
      "type": "link_list",
      "id": "customer_links",
      "label": "Customer Links"
    }
  ]
}
{% endschema %}