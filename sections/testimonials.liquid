{% comment %}
  Testimonials
{% endcomment %}

<section class="j-testimonials full-width">
  <div class="j-testimonials__inner">

  <div class="j-testimonials__heading">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="j-testimonials__grid">
    {% for block in section.blocks %}
      {% case block.type %}

        {% when 'testimonial' %}
          <div class="j-testimonial-card" {{ block.shopify_attributes }}>

            {% if block.settings.rating > 0 %}
              <div class="j-testimonial-card__stars" aria-hidden="true">
                {% for i in (1..5) %}
                  <span class="j-star" style="--fill: {% if i <= block.settings.rating %}100{% else %}0{% endif %}%;">★</span>
                {% endfor %}
              </div>
            {% endif %}

            {% if block.settings.quote != blank %}
              <blockquote class="j-testimonial-card__quote">
                “{{ block.settings.quote }}”
              </blockquote>
            {% endif %}

            <div class="j-testimonial-card__author">

              <div class="j-testimonial-card__avatar">
                {% if block.settings.avatar %}
                  {{
                    block.settings.avatar
                    | image_url: width: 96
                    | image_tag: loading: 'lazy', alt: block.settings.name, widths: '48, 96'
                  }}
                {% else %}
                  <span class="j-testimonial-card__avatar-initial">
                    {{ block.settings.name | slice: 0 | upcase }}
                  </span>
                {% endif %}
              </div>

              <div class="j-testimonial-card__author-info">
                <span class="j-testimonial-card__name">{{ block.settings.name }}</span>
                {% if block.settings.role != blank %}
                  <span class="j-testimonial-card__role">{{ block.settings.role }}</span>
                {% endif %}
              </div>

            </div>

          </div>

        {% when '@app' %}
          {% render block %}

      {% endcase %}
    {% endfor %}
  </div>

  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by our customers"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Real feedback from people who shop with us."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This shop exceeded my expectations. Fast shipping, great quality, and excellent customer service."
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar (optional)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Jane Doe"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Location",
          "default": "Verified Buyer"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
