{% comment %}
  Testimonials — split slideshow: quote/rating/author on the left, a
  large edge-to-edge product photo on the right, one testimonial block
  at a time, crossfading on an autoplay timer (see testimonials.js).
{% endcomment %}

<section class="j-testimonials full-width">
  <div class="j-testimonials__slideshow" data-autoplay="5000">
    <div class="j-testimonials__track">
      {% for block in section.blocks %}
        {% assign block_settings = block.settings %}
        {% case block.type %}

          {% when 'testimonial' %}
            <div
              class="j-testimonials__slide{% if forloop.first %} is-active{% endif %}"
              {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
              {{ block.shopify_attributes }}
            >

              <div class="j-testimonials__content">
                {% if section.settings.eyebrow != blank %}
                  <p class="j-testimonials__eyebrow">{{ section.settings.eyebrow }}</p>
                {% endif %}

                {% if block_settings.rating > 0 %}
                  <div class="j-testimonials__stars" aria-hidden="true">
                    {% for i in (1..5) %}
                      <span class="j-star" style="--fill: {% if i <= block_settings.rating %}100{% else %}0{% endif %}%;">★</span>
                    {% endfor %}
                  </div>
                {% endif %}

                {% if block_settings.quote != blank %}
                  <div class="j-testimonials__quote-wrap">
                    {% comment %}
                      Large decorative quotation mark — this section
                      previously had nothing to distinguish it visually
                      from any other text block on the page (plain gray
                      background, small stars, body-sized quote text).
                      A big oversized mark behind the quote is a
                      standard, low-risk way to give a testimonial
                      section some real presence.
                    {% endcomment %}
                    <svg class="j-testimonials__quote-mark" viewBox="0 0 32 24" fill="none" aria-hidden="true">
                      <path d="M0 24V14.4C0 6.4 4.8 1.2 13.6 0l1.6 4C9.6 5.6 7.2 8.8 6.8 13.2H14V24H0ZM17.6 24V14.4C17.6 6.4 22.4 1.2 31.2 0l1.6 4c-5.6 1.6-8 4.8-8.4 9.2h7.2V24H17.6Z" fill="#f0c14b"/>
                    </svg>
                    <blockquote class="j-testimonials__quote">
                      {{ block_settings.quote }}
                    </blockquote>
                  </div>
                {% endif %}

                <div class="j-testimonials__author">
                  <div class="j-testimonials__avatar">
                    {% if block_settings.avatar %}
                      {% assign img_alt = block_settings.name | default: '' %}
                      {{
                        block_settings.avatar
                        | image_url: width: 96, format: 'webp'
                        | image_tag: loading: 'lazy', alt: img_alt, widths: '48, 96', sizes: '44px'
                      }}
                    {% else %}
                      <span class="j-testimonials__avatar-initial">
                        {{ block_settings.name | slice: 0 | upcase }}
                      </span>
                    {% endif %}
                  </div>

                  <span class="j-testimonials__author-line">
                    — {{ block_settings.name }}{% if block_settings.role != blank %} / {{ block_settings.role }}{% endif %}
                  </span>
                </div>

                <div class="j-testimonials__nav">
                  <button type="button" class="j-testimonials__arrow j-testimonials__arrow--prev" aria-label="{{ 'general.pagination.prev' | t }}">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <button type="button" class="j-testimonials__arrow j-testimonials__arrow--next" aria-label="{{ 'general.pagination.next' | t }}">
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M7.5 5 12.5 10l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="j-testimonials__media">
                {% if block_settings.image %}
                  {% assign img_alt = block_settings.image.alt | default: block_settings.name | default: shop.name %}
                  {%- liquid
                    assign slide_loading = 'lazy'
                    if forloop.first
                      assign slide_loading = 'eager'
                    endif
                    # Written as a positive "not at the top" test so the editor and Section
                    # Rendering API, where section.index is nil, keep the image eager.
                    if section.index > 1 or section.location == 'footer'
                      assign slide_loading = 'lazy'
                    endif
                  -%}
                  {{
                    block_settings.image
                    | image_url: width: 1200, format: 'webp'
                    | image_tag:
                      loading: slide_loading,
                      widths: '600, 750, 900, 1200',
                      sizes: '(max-width: 900px) 92vw, 50vw',
                      alt: img_alt
                  }}
                {% else %}
                  <div class="j-testimonials__media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
                {% endif %}
              </div>

            </div>

          {% when 'custom_liquid' %}
            <div {{ block.shopify_attributes }}>
              {{ block_settings.custom_liquid }}
            </div>

          {% when '@app' %}
            {% render block %}

        {% endcase %}
      {% endfor %}
    </div>
  </div>
</section>

<script src="{{ 'testimonials.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "From the people"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This shop exceeded my expectations. Fast shipping, great quality, and excellent customer service."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Avatar (optional)"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Jane Doe"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Location",
          "default": "Verified Buyer"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid code",
          "info": "Add app snippets, custom HTML, or third-party embed code."
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
