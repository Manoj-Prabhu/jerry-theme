{% comment %}
  About page hero — same page-title-band treatment as Contact/Blog/FAQ
  (see .j-page-hero-band in layout.css), with the page's own rich text
  content (edited in Shopify admin under Content > Pages) as the intro
  paragraph underneath the title.
{% endcomment %}

{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band {% if section.settings.banner_image %}j-page-hero-band--has-image{% endif %}">
  {% if section.settings.banner_image %}
    <div class="j-page-hero-band__image">
      {{
        section.settings.banner_image
        | image_url: width: 1600
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800, 1200, 1600',
          sizes: '100vw',
          alt: page.title
      }}
    </div>
  {% endif %}

  <div class="j-page-hero-band__inner">
    <div class="j-about__header">

      <h1>{{ page.title }}</h1>

      {% if page.content != blank %}
        <div class="j-about__intro">
          {{ page.content }}
        </div>
      {% endif %}

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Main about",
  "settings": [
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image",
      "info": "Shows as a full-width photo behind the page title, with a dark overlay. Leave blank to keep the plain background."
    }
  ]
}
{% endschema %}
