{% comment %}
  Shop by Category
{% endcomment %}

<section class="j-shop-by-category full-width">
  <div class="j-shop-by-category__inner">

  <div class="j-shop-by-category__heading">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="j-shop-by-category__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'category' %}
          <a
            href="{{ block.settings.link }}"
            class="j-category-card"
            {{ block.shopify_attributes }}
          >
            <div class="j-category-card__image">
              {% if block.settings.image %}
                {{
                  block.settings.image
                  | image_url: width: 600
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600',
                    sizes: '(max-width: 768px) 45vw, 22vw',
                    alt: block.settings.title
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'j-category-card__placeholder' }}
              {% endif %}
            </div>
            <span class="j-category-card__title">{{ block.settings.title }}</span>
          </a>
      {% endcase %}
    {% endfor %}
  </div>

  </div>
</section>

{% schema %}
{
  "name": "Shop by Category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find exactly what you're looking for."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop by Category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
