{% comment %}
  Shop by Category
{% endcomment %}

<section class="j-shop-by-category full-width">
  <div class="j-shop-by-category__inner">

  <div class="j-shop-by-category__heading">
    <h2>{{ section.settings.heading }}</h2>
    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}
  </div>

  <div class="j-shop-by-category__grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'category' %}
          <a
            href="{{ block.settings.link }}"
            class="j-category-card"
            draggable="false"
            {{ block.shopify_attributes }}
          >
            <div class="j-category-card__image">
              {% if block.settings.image %}
                {% assign img_alt = block.settings.title | default: shop.name %}
                {{
                  block.settings.image
                  | image_url: width: 800, format: 'webp'
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800',
                    sizes: '(max-width: 768px) 60vw, 26vw',
                    alt: img_alt
                }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'j-category-card__placeholder' }}
              {% endif %}
              {% comment %}
                Caption moved onto the photo (same overlay pattern as
                the header's mega-menu tiles, snippets/announcement-bar
                aside) instead of sitting as small plain text underneath
                — bigger cards + an overlaid title read as an editorial
                lookbook tile instead of a generic thumbnail-plus-label
                grid.
              {% endcomment %}
              <span class="j-category-card__title">{{ block.settings.title }}</span>
            </div>
          </a>
      {% endcase %}
    {% endfor %}
  </div>

  </div>

  {% comment %}
    Curved divider into whatever section follows (typically Featured
    Collection, white) — same idea as hero.liquid's divider into this
    section, closing the loop so the purple gradient doesn't just cut
    off flat into white either.
  {% endcomment %}
  <svg class="j-shop-by-category__divider" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,50 C240,10 480,90 720,60 C960,30 1200,70 1440,40 L1440,80 L0,80 Z" fill="#ffffff"/>
  </svg>
</section>

{% schema %}
{
  "name": "Featured collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find exactly what you're looking for."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Category"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Featured collections",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
