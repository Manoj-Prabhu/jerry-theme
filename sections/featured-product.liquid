{% comment %}
  Featured Product — spotlights up to 4 merchant-chosen products (one per
  "Product" block) anywhere in the store (homepage, a landing page, etc.),
  each with its own media gallery (image/video/external video/3D model —
  same as the full product page) and buy box (variant picker, quantity,
  add to cart, accelerated checkout). With 2+ products, they auto-rotate
  like a slideshow (see featured-product-slideshow.js); with exactly 1,
  it just renders as a static card. Unlike sections/product.liquid, this
  can appear more than once on a page and outside the product template,
  and now renders more than one product's worth of markup at once, so
  every id here is scoped with a per-block unique id (fp_unique_id)
  rather than assuming a single global instance.
{% endcomment %}

{{ 'featured-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-product-slideshow.js' | asset_url }}" defer="defer"></script>

{% style %}
  {{ section.settings.heading_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .j-featured-product__heading {
    font-family: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
    font-style: {{ section.settings.heading_font.style }};
    font-weight: {{ section.settings.heading_font.weight }};
  }
{% endstyle %}

{% assign product_blocks = section.blocks | where: 'type', 'product' %}

<div class="j-featured-product-section">
  <div class="page-width">

    {% if section.settings.heading != blank or section.settings.subtext != blank %}
      <div class="j-featured-product__intro">
        {% if section.settings.heading != blank %}
          <h2 class="j-featured-product__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subtext != blank %}
          <p class="j-featured-product__subtext">{{ section.settings.subtext }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% if product_blocks.size == 0 %}

      <p class="j-featured-product__placeholder">
        Add a Product block in the Theme Editor.
      </p>

    {% else %}

      <div
        class="j-featured-product-slideshow"
        data-autoplay="{{ section.settings.autoplay_speed | times: 1000 }}"
      >

        {% assign fp_rendered_count = 0 %}
        <div class="j-featured-product-slideshow__track">
          {% for block in product_blocks %}
            {% assign fp_product = block.settings.product %}
            {% if fp_product != blank %}
              {% assign fp_unique_id = section.id | append: '-' | append: block.id %}
              {% assign current_variant = fp_product.selected_or_first_available_variant %}
              {% assign main_image_alt = current_variant.featured_image.alt | default: fp_product.title %}

              <div
                class="j-featured-product-card j-featured-product-slide {% if fp_rendered_count == 0 %}is-active{% endif %} {% if section.settings.image_position == 'right' %}j-featured-product-card--image-right{% endif %}"
                data-section-id="{{ fp_unique_id }}"
                {{ block.shopify_attributes }}
              >
              {% assign fp_rendered_count = fp_rendered_count | plus: 1 %}

        <!-- Buy box -->
        <div class="j-featured-product__content">

          {% if block.settings.eyebrow != blank %}
            <p class="j-featured-product__eyebrow">{{ block.settings.eyebrow }}</p>
          {% endif %}

          <h3 class="j-featured-product__title">
            <a href="{{ fp_product.url }}">{{ fp_product.title }}</a>
          </h3>

          <div class="j-featured-product__price-row">
            {% if current_variant.compare_at_price > current_variant.price %}
              <del class="j-featured-product__price-compare" id="FeaturedProductComparePrice-{{ fp_unique_id }}">
                {{ current_variant.compare_at_price | money }}
              </del>
            {% else %}
              <del class="j-featured-product__price-compare" id="FeaturedProductComparePrice-{{ fp_unique_id }}" hidden></del>
            {% endif %}

            <p class="j-featured-product__price" id="FeaturedProductPrice-{{ fp_unique_id }}">
              {{ current_variant.price | money }}
            </p>

            {% if current_variant.compare_at_price > current_variant.price %}
              {% assign fp_discount_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price %}
              <span class="j-featured-product__badge j-featured-product__badge--sale" id="FeaturedProductSaleBadge-{{ fp_unique_id }}">
                {{ 'product.sale' | t }}
              </span>
              <span class="j-featured-product__badge j-featured-product__badge--percent" id="FeaturedProductPercentBadge-{{ fp_unique_id }}">
                -{{ fp_discount_percent }}%
              </span>
            {% else %}
              <span class="j-featured-product__badge j-featured-product__badge--sale" id="FeaturedProductSaleBadge-{{ fp_unique_id }}" hidden>{{ 'product.sale' | t }}</span>
              <span class="j-featured-product__badge j-featured-product__badge--percent" id="FeaturedProductPercentBadge-{{ fp_unique_id }}" hidden></span>
            {% endif %}
          </div>

          {% if cart.taxes_included %}
            <p class="j-featured-product__tax-note">{{ 'product.taxes_included' | t }}</p>
          {% endif %}

          {% form 'product', fp_product, class: 'j-featured-product__form' %}

            <input
              type="hidden"
              name="id"
              id="FeaturedProductSelectedVariant-{{ fp_unique_id }}"
              value="{{ current_variant.id }}"
            >

            {% if fp_product.has_only_default_variant == false %}
              <div class="j-featured-product__options" id="FeaturedProductOptions-{{ fp_unique_id }}">
                {% for option in fp_product.options_with_values %}
                  {% assign option_index = forloop.index0 %}
                  {% assign option_name_down = option.name | downcase %}
                  {% assign selected_value = current_variant.options[option_index] %}

                  <div class="j-featured-product__option">
                    <div class="j-featured-product__option-header">
                      <label>{{ option.name }}:</label>
                      <span class="j-featured-product__option-value">{{ selected_value }}</span>
                    </div>

                    {% if option_name_down == 'color' or option_name_down == 'colour' %}
                      <div class="j-featured-product__swatches">
                        {% for value in option.values %}
                          {% assign color_key = value | remove: ' ' | remove: '-' | downcase %}
                          <button
                            type="button"
                            class="j-featured-product__swatch {% if value == selected_value %}is-active{% endif %}"
                            data-option-index="{{ option_index }}"
                            data-value="{{ value | escape }}"
                            aria-label="{{ value | escape }}"
                            aria-pressed="{% if value == selected_value %}true{% else %}false{% endif %}"
                            title="{{ value | escape }}"
                          >
                            {% if value.swatch.image %}
                              <span class="j-featured-product__swatch-inner" style="background-image: url({{ value.swatch.image | image_url: width: 60, format: 'webp' }});"></span>
                            {% elsif value.swatch.color %}
                              <span class="j-featured-product__swatch-inner" style="background-color: {{ value.swatch.color }};"></span>
                            {% else %}
                              <span class="j-featured-product__swatch-inner" style="background-color: {{ color_key }};"></span>
                            {% endif %}
                          </button>
                        {% endfor %}
                      </div>
                    {% else %}
                      <div class="j-featured-product__pills">
                        {% for value in option.values %}
                          <button
                            type="button"
                            class="j-featured-product__pill {% if value == selected_value %}is-active{% endif %}"
                            data-option-index="{{ option_index }}"
                            data-value="{{ value | escape }}"
                            aria-pressed="{% if value == selected_value %}true{% else %}false{% endif %}"
                          >
                            {{ value }}
                          </button>
                        {% endfor %}
                      </div>
                    {% endif %}
                  </div>
                {% endfor %}
              </div>

              {% capture fp_variants_json %}[
                {% for variant in fp_product.variants %}
                  {
                    "id": {{ variant.id }},
                    "available": {{ variant.available }},
                    "price": {{ variant.price | money | json }},
                    "compareAtPrice": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
                    "discountPercent": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}{% else %}null{% endif %},
                    "options": {{ variant.options | json }},
                    "featuredMediaId": {{ variant.featured_media.id | json }}
                  }{% unless forloop.last %},{% endunless %}
                {% endfor %}
              ]{% endcapture %}
              <script type="application/json" id="FeaturedProductVariantsJson-{{ fp_unique_id }}">{{ fp_variants_json }}</script>
            {% endif %}

            <div class="j-featured-product__cart-row">
              <div class="j-featured-product__quantity">
                <label for="FeaturedProductQuantity-{{ fp_unique_id }}" class="j-featured-product__quantity-label">
                  {{ 'product.quantity' | t }}
                </label>
                <div class="j-featured-product__qty-control">
                  <button type="button" class="j-featured-product__qty-minus" aria-label="{{ 'cart.decrease_quantity' | t }}">−</button>
                  <input
                    id="FeaturedProductQuantity-{{ fp_unique_id }}"
                    type="number"
                    name="quantity"
                    min="1"
                    value="1"
                  >
                  <button type="button" class="j-featured-product__qty-plus" aria-label="{{ 'cart.increase_quantity' | t }}">+</button>
                </div>
              </div>

              <button
                type="submit"
                class="j-button j-button-outline--gold j-featured-product__add"
                id="FeaturedProductAddToCart-{{ fp_unique_id }}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M4 6h13l-1.5 8.5a1.5 1.5 0 0 1-1.48 1.25H6.98a1.5 1.5 0 0 1-1.48-1.25L4 6Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  <path d="M6.5 6V4.5a3.5 3.5 0 0 1 7 0V6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                </svg>
                <span id="FeaturedProductAddToCartText-{{ fp_unique_id }}">
                  {% if current_variant.available %}
                    {{ 'product.add_to_cart' | t }}
                  {% else %}
                    {{ 'product.sold_out' | t }}
                  {% endif %}
                </span>
              </button>
            </div>

            <p class="j-featured-product__form-error" id="FeaturedProductFormError-{{ fp_unique_id }}" role="alert" hidden></p>

            {% if current_variant.available %}
              <div class="j-featured-product__payment-button" style="--shopify-payment-button-color-scheme: dark;">
                {{ form | payment_button }}
              </div>
            {% endif %}

          {% endform %}

          {% if current_variant.store_availabilities.size > 0 %}
            {% assign fp_pickup_location = current_variant.store_availabilities.first %}
            <p class="j-featured-product__pickup" id="FeaturedProductPickup-{{ fp_unique_id }}">
              {% if fp_pickup_location.available %}
                <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5 6.5 12 13 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {{ 'product.pickup_available_html' | t: location: fp_pickup_location.location.name }}
              {% else %}
                {{ 'product.pickup_unavailable_html' | t: location: fp_pickup_location.location.name }}
              {% endif %}
            </p>
          {% endif %}

          <a href="{{ fp_product.url }}" class="j-featured-product__link">
            {{ 'product.view_full_details' | t }}
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>

        </div>

        <!-- Media -->
        <div class="j-featured-product__gallery">

          <div class="j-featured-product__main-media">
            {% for media in fp_product.media %}
              {% liquid
                assign is_active = false
                if media.id == current_variant.featured_media.id
                  assign is_active = true
                elsif current_variant.featured_media == blank and forloop.first
                  assign is_active = true
                endif
              %}

              <div
                class="j-featured-product__media-slide {% if is_active %}is-active{% endif %}"
                data-media-id="{{ media.id }}"
              >
                {% case media.media_type %}
                  {% when 'image' %}
                    {{
                      media
                      | image_url: width: 900, format: 'webp'
                      | image_tag:
                        class: 'j-featured-product__image',
                        loading: 'lazy',
                        widths: '400, 600, 800, 900',
                        sizes: '(max-width: 768px) 100vw, 500px',
                        alt: media.alt | default: main_image_alt
                    }}
                  {% when 'video' %}
                    {{ media | video_tag: image_size: '900x', controls: true, controlslist: 'nodownload' }}
                  {% when 'external_video' %}
                    {{ media | external_video_tag: image_size: '900x' }}
                  {% when 'model' %}
                    {{ media | model_viewer_tag: image_size: '900x' }}
                  {% else %}
                    {{ media | media_tag: image_size: '900x' }}
                {% endcase %}
              </div>
            {% else %}
              <div class="j-featured-product__media-slide is-active">
                {{ 'product-1' | placeholder_svg_tag: 'j-featured-product__placeholder-svg' }}
              </div>
            {% endfor %}
          </div>

          {% if fp_product.media.size > 1 %}
            <div class="j-featured-product__thumbnails-wrap">

              <button type="button" class="j-featured-product__thumb-arrow j-featured-product__thumb-arrow--prev" aria-label="{{ 'general.pagination.prev' | t }}" hidden>
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

              <div class="j-featured-product__thumbnails">
                {% for media in fp_product.media %}
                  {% assign is_active = false %}
                  {% if media.id == current_variant.featured_media.id %}
                    {% assign is_active = true %}
                  {% elsif current_variant.featured_media == blank and forloop.first %}
                    {% assign is_active = true %}
                  {% endif %}

                  <button
                    type="button"
                    class="j-featured-product__thumb {% if is_active %}is-active{% endif %}"
                    data-media-id="{{ media.id }}"
                    aria-label="{{ fp_product.title }} — {{ forloop.index }}"
                  >
                    {{
                      media.preview_image
                      | image_url: width: 240
                      | image_tag:
                        loading: 'lazy',
                        alt: '',
                        widths: '108, 140, 240',
                        sizes: '140px'
                    }}
                    {% if media.media_type == 'video' or media.media_type == 'external_video' %}
                      <span class="j-featured-product__thumb-icon" aria-hidden="true">▶</span>
                    {% elsif media.media_type == 'model' %}
                      <span class="j-featured-product__thumb-icon j-featured-product__thumb-icon--model" aria-hidden="true">3D</span>
                    {% endif %}
                  </button>
                {% endfor %}
              </div>

              <button type="button" class="j-featured-product__thumb-arrow j-featured-product__thumb-arrow--next" aria-label="{{ 'general.pagination.next' | t }}" hidden>
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M7.5 5 12.5 10l-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>

            </div>
          {% endif %}

        </div>

      </div>
            {% endif %}
          {% endfor %}
        </div>

      </div>

    {% endif %}

    {% for content_block in section.blocks %}
      {% case content_block.type %}
        {% when 'custom_liquid' %}
          <div {{ content_block.shopify_attributes }}>
            {{ content_block.settings.custom_liquid }}
          </div>
        {% when '@app' %}
          {% render content_block %}
      {% endcase %}
    {% endfor %}

  </div>
</div>

<script src="{{ 'featured-product.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Featured product",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured product"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "quantico_n7"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subheading",
      "info": "Short supporting line shown below the heading."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Rotation speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Only used when 2 or more products are added below."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid code",
          "info": "Add app snippets, custom HTML, or third-party embed code."
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Featured product",
      "blocks": [
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
