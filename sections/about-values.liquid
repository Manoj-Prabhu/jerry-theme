{% comment %}
  About page — grid of value/pillar cards (e.g. Quality, Sustainability,
  Craftsmanship, Community), each a repeatable block with its own icon,
  heading, and text.
{% endcomment %}

{% liquid
  assign value_blocks = section.blocks | where: 'type', 'value'
%}

{% if value_blocks.size > 0 %}
  <section class="j-about-values full-width">
    <div class="j-about-values__inner">

      {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
        <div class="j-about-values__header">
          {% if section.settings.eyebrow != blank %}
            <span class="j-about-values__eyebrow">{{ section.settings.eyebrow }}</span>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="j-about-values__heading">{{ section.settings.heading }}</h2>
          {% endif %}
        </div>
      {% endif %}

      <div class="j-about-values__grid">
        {% for block in value_blocks %}
          <div class="j-about-values__card" {{ block.shopify_attributes }}>
            <span class="j-about-values__icon" aria-hidden="true">
              {% case block.settings.icon %}
                {% when 'quality' %}
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M10 2.5 12.2 7l5 .7-3.6 3.5.9 5-4.5-2.4L5.5 16.2l.9-5-3.6-3.5 5-.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                {% when 'sustainability' %}
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M10 17.5c-4-.5-6.5-3.5-6.5-7.5C3.5 6 6.5 3 10 2.5c4 .5 6.5 3.5 6.5 7.5 0 4-2.5 7-6.5 7.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <path d="M10 17.5V8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M10 11c0-2.5 2-4.5 4.5-4.5C14.5 9 12.5 11 10 11Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                {% when 'craftsmanship' %}
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M12.5 2.5 17.5 7.5 8 17H3v-5L12.5 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <path d="m10.5 4.5 5 5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  </svg>
                {% when 'community' %}
                  <svg viewBox="0 0 20 20" fill="none">
                    <circle cx="7" cy="7" r="2.5" stroke="currentColor" stroke-width="1.4"/>
                    <circle cx="14" cy="8" r="2" stroke="currentColor" stroke-width="1.4"/>
                    <path d="M2.5 16.5c0-2.8 2-4.5 4.5-4.5s4.5 1.7 4.5 4.5" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                    <path d="M12.5 12.3c2 .2 3.5 1.8 3.5 4.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                  </svg>
                {% when 'heart' %}
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M10 17S3 12.6 3 7.8C3 5.2 5 3.5 7.3 3.5c1.2 0 2.3.6 2.7 1.5.4-.9 1.5-1.5 2.7-1.5C15 3.5 17 5.2 17 7.8 17 12.6 10 17 10 17Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                  </svg>
                {% else %}
                  <svg viewBox="0 0 20 20" fill="none">
                    <path d="M10 2.5 16 4.5v4c0 4.2-2.6 7.2-6 8.5-3.4-1.3-6-4.3-6-8.5v-4L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                    <path d="M7.3 9.8 9.2 11.7 12.8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
              {% endcase %}
            </span>
            <h3 class="j-about-values__card-heading">{{ block.settings.heading }}</h3>
            <p class="j-about-values__card-text">{{ block.settings.text }}</p>
          </div>
        {% endfor %}
      </div>

    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "About values",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "What We Stand For"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Values"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "quality", "label": "Quality" },
            { "value": "sustainability", "label": "Sustainability" },
            { "value": "craftsmanship", "label": "Craftsmanship" },
            { "value": "community", "label": "Community" },
            { "value": "heart", "label": "Care" },
            { "value": "secure", "label": "Trust" }
          ],
          "default": "quality"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quality First"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "We choose every material and maker carefully, so what you get is built to last."
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "About values",
      "blocks": [
        {
          "type": "value",
          "settings": { "icon": "quality", "heading": "Quality First", "text": "We choose every material and maker carefully, so what you get is built to last." }
        },
        {
          "type": "value",
          "settings": { "icon": "sustainability", "heading": "Sustainably Made", "text": "Thoughtful sourcing and low-waste production, from idea to shelf." }
        },
        {
          "type": "value",
          "settings": { "icon": "craftsmanship", "heading": "Real Craftsmanship", "text": "Every piece is made by hand or with care by people who know the trade." }
        },
        {
          "type": "value",
          "settings": { "icon": "community", "heading": "Community First", "text": "We build with our customers, not just for them — your feedback shapes what we make next." }
        }
      ]
    }
  ]
}
{% endschema %}
