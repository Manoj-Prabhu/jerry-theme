{% comment %}
  Product Section
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

<div class="page-width">
  {% render 'breadcrumbs' %}
</div>

<div class="j-product">

  <!-- Product Images -->
  <div class="j-product__gallery">

    <div class="j-product__main-image">

      {% render 'product-badges', product: product %}

      {{
        current_variant.featured_image | default: product.featured_image
        | image_url: width: 1000
        | image_tag:
          class: 'j-product-main-image',
          id: 'ProductMainImage'
      }}

    </div>

    <div class="j-product__thumbnails">

      {% assign current_image = current_variant.featured_image | default: product.featured_image %}

      {% for image in product.images %}

        <button
          type="button"
          class="j-product-thumbnail {% if image == current_image %}is-active{% endif %}"
          data-image="{{ image | image_url: width: 1200 }}"
        >

          {{
            image
            | image_url: width: 150
            | image_tag
          }}

        </button>

      {% endfor %}

    </div>

  </div>

  <!-- Product Content -->
  <div class="j-product__content">

    <h1 class="j-product__title">
      {{ product.title }}
    </h1>

    <p
      class="j-product__price"
      id="ProductPrice"
    >
      {{ current_variant.price | money }}
    </p>

    <div class="j-product__description">
      {{ product.description }}
    </div>

    {% form 'product', product, class: 'product-form j-product-form' %}

      <input
        type="hidden"
        name="id"
        id="SelectedVariant"
        value="{{ current_variant.id }}"
      >

      {% if product.has_only_default_variant == false %}

        <div class="j-product__options" id="ProductOptions">

          {% for option in product.options_with_values %}
            {% assign option_index = forloop.index0 %}
            {% assign option_name_down = option.name | downcase %}
            {% assign selected_value = current_variant.options[option_index] %}

            <div class="j-product__option">

              <div class="j-product__option-header">
                <label>{{ option.name }}</label>
                <span class="j-product__option-value">{{ selected_value }}</span>
              </div>

              {% if option_name_down == 'color' or option_name_down == 'colour' %}

                <div class="j-product__swatches">
                  {% for value in option.values %}
                    {% assign color_key = value | remove: ' ' | remove: '-' | downcase %}
                    <button
                      type="button"
                      class="j-product__swatch {% if value == selected_value %}is-active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-value="{{ value | escape }}"
                      aria-label="{{ value | escape }}"
                      title="{{ value | escape }}"
                    >
                      <span class="j-product__swatch-inner" style="background-color: {{ color_key }};"></span>
                    </button>
                  {% endfor %}
                </div>

              {% else %}

                <div class="j-product__pills">
                  {% for value in option.values %}
                    <button
                      type="button"
                      class="j-product__pill {% if value == selected_value %}is-active{% endif %}"
                      data-option-index="{{ option_index }}"
                      data-value="{{ value | escape }}"
                    >
                      {{ value }}
                    </button>
                  {% endfor %}
                </div>

              {% endif %}

            </div>
          {% endfor %}

        </div>

        {% capture variants_json %}[
          {% for variant in product.variants %}
            {
              "id": {{ variant.id }},
              "available": {{ variant.available }},
              "price": {{ variant.price | money | json }},
              "options": {{ variant.options | json }},
              "image": {{ variant.featured_image | default: product.featured_image | image_url: width: 1200 | json }}
            }{% unless forloop.last %},{% endunless %}
          {% endfor %}
        ]{% endcapture %}
        <script type="application/json" id="ProductVariantsJson">{{ variants_json }}</script>

      {% endif %}

      <label for="Quantity">
        Quantity
      </label>

      <input
        id="Quantity"
        type="number"
        name="quantity"
        min="1"
        value="1"
      >

      <button
        type="submit"
        class="j-button"
        id="AddToCartButton"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {% if current_variant.available %}
          Add to Cart
        {% else %}
          Sold Out
        {% endif %}
      </button>

      <button
        type="submit"
        class="j-button j-buy-now"
        id="BuyNowButton"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        Buy it now
      </button>

      <p
        class="j-product__form-error"
        id="ProductFormError"
        hidden
      ></p>

    {% endform %}

  </div>
  <div
  class="j-sticky-cart"
  id="StickyCart"
>

  <div class="j-sticky-cart__product">

    <div class="j-sticky-cart__image">
      {{
        current_variant.featured_image | default: product.featured_image
        | image_url: width: 100
        | image_tag: alt: product.title
      }}
    </div>

    <div class="j-sticky-cart__info">

      <h4>{{ product.title }}</h4>

      <p id="StickyPrice">
        {{ current_variant.price | money }}
      </p>

    </div>

  </div>

    <button
      type="button"
      class="j-button"
      id="StickyAddToCart"
    >
      Add to Cart
    </button>

  </div>

</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}