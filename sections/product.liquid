{% comment %}
  Product Section
{% endcomment %}

<div class="j-product">

  <!-- Product Images -->
  <div class="j-product__images">
    {% for image in product.images %}
      <div class="j-product__image">
        {% render 'image', class: 'product-image', image: image %}
      </div>
    {% endfor %}
  </div>

  <!-- Product Content -->
  <div class="j-product__content">

    <h1 class="j-product__title">
      {{ product.title }}
    </h1>

    <p class="j-product__price">
      {{ product.price | money }}
    </p>

    <div class="j-product__description">
      {{ product.description }}
    </div>

    {% form 'product', product, class: 'product-form' %}

      {% assign current_variant = product.selected_or_first_available_variant %}

      {% if product.has_only_default_variant == false %}
        <label for="ProductVariant">
          Variant
        </label>

        <select
          id="ProductVariant"
          name="id"
        >
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}
                selected
              {% endif %}
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      {% endif %}

      <label for="Quantity">
        Quantity
      </label>

      <input
        id="Quantity"
        type="number"
        name="quantity"
        min="1"
        value="1"
      >

      <button
        type="submit"
        class="j-button"
      >
        Add to Cart
      </button>

      {{ form | payment_button }}

    {% endform %}

  </div>

</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}