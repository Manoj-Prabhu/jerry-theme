{% comment %}
  Product Section
{% endcomment %}

<div class="j-product">

  <!-- Product Images -->
  <div class="j-product__gallery">

    <div class="j-product__main-image">

      {{ product.featured_image
        | image_url: width: 1000
        | image_tag:
            class: 'j-product-main-image',
            id: 'ProductMainImage'
      }}

    </div>

    <div class="j-product__thumbnails">

      {% for image in product.images %}

        <button
          type="button"
          class="j-product-thumbnail {% if forloop.first %}is-active{% endif %}"
          data-image="{{ image | image_url: width: 1200 }}"
        >

          {{
            image
            | image_url: width: 150
            | image_tag
          }}

        </button>

      {% endfor %}

    </div>

  </div>

  <!-- Product Content -->
  <div class="j-product__content">

    <h1 class="j-product__title">
      {{ product.title }}
    </h1>

    <p class="j-product__price">
      {{ product.price | money }}
    </p>

    <div class="j-product__description">
      {{ product.description }}
    </div>

    {% form 'product', product, class: 'product-form j-product-form' %}

      {% assign current_variant = product.selected_or_first_available_variant %}

      <input
        type="hidden"
        name="id"
        value="{{ current_variant.id }}"
      >

      {% if product.has_only_default_variant == false %}
        <label for="ProductVariant">
          Variant
        </label>

        <select
          id="ProductVariant"
          name="id"
        >
          {% for variant in product.variants %}
            <option
              value="{{ variant.id }}"
              {% if variant == current_variant %}
                selected
              {% endif %}
            >
              {{ variant.title }} - {{ variant.price | money }}
            </option>
          {% endfor %}
        </select>
      {% endif %}

      <label for="Quantity">
        Quantity
      </label>

      <input
        id="Quantity"
        type="number"
        name="quantity"
        min="1"
        value="1"
      >

      <button
        type="submit"
        class="j-button"
        id="AddToCartButton"
      >
        Add to Cart
      </button>

      {% comment %}
      {{ form | payment_button }}
      {% endcomment %}

    {% endform %}

  </div>

</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}