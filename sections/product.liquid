{% comment %}
  Product Section
{% endcomment %}

{% assign current_variant = product.selected_or_first_available_variant %}

<div class="j-product">

  <!-- Product Images -->
  <div class="j-product__gallery">

    <div class="j-product__main-image">

      {{
        current_variant.featured_image | default: product.featured_image
        | image_url: width: 1000
        | image_tag:
          class: 'j-product-main-image',
          id: 'ProductMainImage'
      }}

    </div>

    <div class="j-product__thumbnails">

      {% for image in product.images %}

        <button
          type="button"
          class="j-product-thumbnail {% if forloop.first %}is-active{% endif %}"
          data-image="{{ image | image_url: width: 1200 }}"
        >

          {{
            image
            | image_url: width: 150
            | image_tag
          }}

        </button>

      {% endfor %}

    </div>

  </div>

  <!-- Product Content -->
  <div class="j-product__content">

    <h1 class="j-product__title">
      {{ product.title }}
    </h1>

    <p
      class="j-product__price"
      id="ProductPrice"
    >
      {{ current_variant.price | money }}
    </p>

    <div class="j-product__description">
      {{ product.description }}
    </div>

    {% form 'product', product, class: 'product-form j-product-form' %}

      <input
        type="hidden"
        name="id"
        id="SelectedVariant"
        value="{{ current_variant.id }}"
      >

      {% if product.has_only_default_variant == false %}

        <div class="j-product__variants">

          <label>
            {{ product.options.first }}
          </label>

          <div class="j-product__variant-buttons">

            {% for variant in product.variants %}

              <button
                type="button"
                class="j-product__variant-button {% if variant.id == current_variant.id %}is-active{% endif %} {% unless variant.available %}is-sold-out{% endunless %}"
                data-variant-id="{{ variant.id }}"
                data-price="{{ variant.price | money }}"
                data-available="{{ variant.available }}"
                data-has-own-image="{% if variant.featured_image %}true{% else %}false{% endif %}"
                data-image="{% if variant.featured_image %}{{ variant.featured_image | image_url: width: 1200 }}{% else %}{{ product.featured_image | image_url: width: 1200 }}{% endif %}"
                {% unless variant.available %}disabled{% endunless %}
              >
                <span class="j-product__variant-label">{{ variant.title }}</span>
                {% unless variant.available %}
                  <span class="j-product__variant-badge">Sold Out</span>
                {% endunless %}
              </button>

            {% endfor %}

          </div>

        </div>

      {% endif %}

      <label for="Quantity">
        Quantity
      </label>

      <input
        id="Quantity"
        type="number"
        name="quantity"
        min="1"
        value="1"
      >

      <button
        type="submit"
        class="j-button"
        id="AddToCartButton"
        {% unless current_variant.available %}disabled{% endunless %}
      >
        {% if current_variant.available %}
          Add to Cart
        {% else %}
          Sold Out
        {% endif %}
      </button>

      <p
        class="j-product__form-error"
        id="ProductFormError"
        hidden
      ></p>

      {% comment %}
        {{ form | payment_button }}
      {% endcomment %}

    {% endform %}

  </div>

</div>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}