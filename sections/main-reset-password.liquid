{% comment %}
  Customer Password Reset
{% endcomment %}

<div class="page-width j-account">

  <div class="j-account__narrow">

    <h1>{{ 'customers.reset_password.title' | t }}</h1>
    <p class="j-account__subtext">{{ 'customers.reset_password.subtext' | t }}</p>

    {% form 'reset_customer_password' %}

      {{ form.errors | default_errors }}

      <div class="j-account__field">
        <label for="ResetPassword">{{ 'customers.reset_password.password' | t }}</label>
        <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password" required>
      </div>

      <div class="j-account__field">
        <label for="ResetPasswordConfirmation">{{ 'customers.reset_password.password_confirm' | t }}</label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="ResetPasswordConfirmation"
          autocomplete="new-password"
          required
        >
      </div>

      <div class="j-account__actions">
        <button type="submit" class="j-button">{{ 'customers.reset_password.submit' | t }}</button>
      </div>

    {% endform %}

  </div>

</div>

{% schema %}
{
  "name": "Reset Password",
  "settings": []
}
{% endschema %}
