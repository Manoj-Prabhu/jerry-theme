{% comment %}
  Renders either "related" or "complementary" product recommendations,
  depending on section.settings.intent. Reused as the server-side render
  target for Shopify's /recommendations/products AJAX endpoint (the
  {% if recommendations.performed %} branch), which is how the {% else %}
  branch below gets its content filled in client-side on initial page load
  (see assets/product-recommendations.js).

  Since a product page can have both a "related" and a "complementary"
  instance of this same section type at once, nothing here relies on a
  fixed/global id — everything is scoped via section.id and data attributes
  so multiple instances don't collide.
{% endcomment %}

{% if recommendations.performed %}

  {% if recommendations.products_count > 0 %}

    <div class="j-product-recommendations">

      <h2 class="j-section-title">
        {% if section.settings.intent == 'complementary' %}
          {{ 'product.complementary_title' | t }}
        {% else %}
          {{ 'product.recommendations_title' | t }}
        {% endif %}
      </h2>

      <div class="j-product-grid">

        {% for product in recommendations.products %}

          {% render 'product-card', product: product %}

        {% endfor %}

      </div>

    </div>

  {% endif %}

{% else %}

  <div
    class="j-product-recommendations"
    data-section-id="{{ section.id }}"
    data-intent="{{ section.settings.intent }}"
    data-product-id="{{ product.id }}"
    data-limit="4"
  >

    <h2 class="j-section-title">
      {% if section.settings.intent == 'complementary' %}
        {{ 'product.complementary_title' | t }}
      {% else %}
        {{ 'product.recommendations_title' | t }}
      {% endif %}
    </h2>

    <div class="j-product-grid"></div>

  </div>

{% endif %}

{% schema %}
{
  "name": "Product Recommendations",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        {
          "value": "related",
          "label": "Related products"
        },
        {
          "value": "complementary",
          "label": "Complementary products"
        }
      ],
      "default": "related"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
