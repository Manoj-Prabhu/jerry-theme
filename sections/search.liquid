{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <h1>{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="j-search-page-form">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-label="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="j-button">{{ 'search.submit' | t }}</button>
    </form>

    {% if search.performed %}
      <p class="j-search-page-count">
        {% if search.results_count == 0 %}
          {{ 'search.no_results_html' | t: terms: search.terms }}
        {% else %}
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        {% endif %}
      </p>
    {% endif %}
  </div>
</div>

{% if search.performed and search.results_count > 0 %}

  <section class="j-collection">

    <div class="page-width">

      {% paginate search.results by 20 %}

        <div class="j-product-grid">

          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              {% render 'product-card', product: result %}
            {% endif %}
          {% endfor %}

        </div>

        {% if paginate.pages > 1 %}
          {{ paginate | default_pagination }}
        {% endif %}

      {% endpaginate %}

    </div>

  </section>

{% endif %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
