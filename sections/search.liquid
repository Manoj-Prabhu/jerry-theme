{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <h1>{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" role="search" class="j-search-page-form">
      <input type="hidden" name="type" value="product">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'search.placeholder' | t }}"
        aria-label="{{ 'search.placeholder' | t }}"
      >
      <button type="submit" class="j-button">{{ 'search.submit' | t }}</button>
    </form>

    {% if search.performed %}
      <p class="j-search-page-count">
        {% if search.results_count == 0 %}
          {{ 'search.no_results_html' | t: terms: search.terms }}
        {% else %}
          {{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}
        {% endif %}
      </p>
    {% endif %}
  </div>
</div>

{% if search.performed and search.results_count > 0 %}

  <section class="j-collection">

    <div class="page-width">

      <div class="j-collection-layout">

        <aside class="j-collection-sidebar" id="CollectionFilters">
          {% render 'collection-filters', filters: search.filters, sort_by: search.sort_by, clear_url: routes.search_url %}
        </aside>

        <div class="j-filter-overlay"></div>

        <div class="j-collection-content">

          <div class="j-collection-toolbar">
            <button
              type="button"
              class="j-filter-toggle"
              aria-expanded="false"
              aria-controls="CollectionFilters"
            >
              <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path d="M3 5h14M6 10h8M8.5 15h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
              {{ 'filters.title' | t }}
            </button>

            <form id="CollectionSortForm">
              <label for="SortBy">
                {{ 'collection.sort_by' | t }}
              </label>

              <div class="j-collection-sort">

                <select
                  id="SortBy"
                  name="sort_by"
                >
                  {% for option in search.sort_options %}
                    <option
                      value="{{ option.value }}"
                      {% if option.value == search.sort_by %}selected{% endif %}
                    >
                      {{ option.name }}
                    </option>
                  {% endfor %}
                </select>

                <svg class="j-collection-sort__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

              </div>
            </form>
          </div>

          {% paginate search.results by 20 %}

            <div class="j-collection-grid">

              {% for result in search.results %}
                {% if result.object_type == 'product' %}
                  {% render 'product-card', product: result %}
                {% endif %}
              {% endfor %}

            </div>

            {% if paginate.pages > 1 %}
              {{ paginate | default_pagination }}
            {% endif %}

          {% endpaginate %}

        </div>

      </div>

    </div>

  </section>

{% endif %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
