<div class="j-article page-width">

  {% render 'breadcrumbs' %}

  {% if article.image %}
    <div class="j-article__hero">
      {{
        article.image
        | image_url: width: 1400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: article.title,
          widths: '400, 500, 600, 700, 800, 1000, 1200, 1400',
          sizes: '(max-width: 700px) 100vw, 700px'
      }}
    </div>
  {% endif %}

  <header class="j-article__header">

    <h1>{{ article.title }}</h1>

    <div class="j-article__meta">
      <span>{{ article.author }}</span>
      <span>•</span>
      <span>{{ article.published_at | date: "%B %d, %Y" }}</span>
    </div>

  </header>

  <div class="j-article__content">
    {{ article.content }}
  </div>

  {% if blog.next_article or blog.previous_article %}
    <div class="j-article__navigation">

      {% if blog.previous_article %}
        <a href="{{ blog.previous_article.url }}">
          ← {{ blog.previous_article.title }}
        </a>
      {% endif %}

      {% if blog.next_article %}
        <a href="{{ blog.next_article.url }}">
          {{ blog.next_article.title }} →
        </a>
      {% endif %}

    </div>
  {% endif %}

</div>

{% schema %}
{
  "name": "Article",
  "settings": []
}
{% endschema %}