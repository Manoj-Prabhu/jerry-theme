{% render 'breadcrumbs' %}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <div class="j-faq__header">

      <h1>{{ page.title }}</h1>

      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle }}</p>
      {% endif %}

    </div>
  </div>
</div>

<div class="j-faq page-width">

  {% if page.content != blank %}
    <div class="j-faq__content">
      {{ page.content }}
    </div>
  {% endif %}

  {% assign category_count = 0 %}
  {% for block in section.blocks %}
    {% if block.type == 'category' %}
      {% assign category_count = category_count | plus: 1 %}
    {% endif %}
  {% endfor %}
  {% assign faq_row_count = category_count | plus: 1 | divided_by: 2 %}

  {% # theme-check-disable UnclosedHTMLElement %}
  {% comment %}
    Each "category" block opens a .j-faq__group wrapper that stays open
    until the next category block (or the end of the loop) closes it —
    grouping a heading with the questions under it into one grid item, so
    a category's heading and its questions always move together.
    grid-auto-flow: column (assets/faq.css) fills column 1 top-to-bottom
    then column 2, with faq_row_count giving it an explicit row count so
    matching rows share a height and headings line up across both columns
    (rather than columns flowing independently, as CSS multi-column would).
    Theme Check's static analysis can't trace a div opened in one loop
    iteration and closed in a later one, but the rendered output is
    verified balanced: every branch that can open group_open has a
    matching branch that closes it before the loop ends.
  {% endcomment %}
  <div class="j-faq__items" style="--faq-rows: {{ faq_row_count }};">

    {% assign group_open = false %}

    {% for block in section.blocks %}

      {% case block.type %}

        {% when 'category' %}

          {% if group_open %}
            </div>
          {% endif %}

          <div class="j-faq__group" {{ block.shopify_attributes }}>

            <h2 class="j-faq__category">
              {{ block.settings.heading }}
            </h2>

            {% assign group_open = true %}

        {% when 'faq' %}

          <details
            class="j-faq__item"
            {{ block.shopify_attributes }}
          >

            <summary class="j-faq__question">
              {{ block.settings.question }}
            </summary>

            <div class="j-faq__answer">
              {{ block.settings.answer }}
            </div>

          </details>

      {% endcase %}

    {% endfor %}

    {% if group_open %}
      </div>
    {% endif %}

  </div>
  {% # theme-check-enable UnclosedHTMLElement %}

  {% for block in section.blocks %}
    {% if block.type == 'note' %}
      <div class="j-faq__note" {{ block.shopify_attributes }}>
        {% if block.settings.heading != blank %}
          <h2 class="j-faq__note-heading">{{ block.settings.heading }}</h2>
        {% endif %}
        <div class="j-faq__note-content">
          {{ block.settings.content }}
        </div>
      </div>
    {% endif %}
  {% endfor %}

</div>

{% schema %}
{
  "name": "Main FAQ",
  "settings": [
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Frequently Asked Questions"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category heading",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Orders"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is your return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>You can return any item within 30 days.</p>"
        }
      ]
    },
    {
      "type": "note",
      "name": "Note",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Still Need Help?"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>If you couldn't find the answer you're looking for, contact our customer support team.</p>"
        }
      ]
    }
  ],
  "max_blocks": 40,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        },
        {
          "type": "faq"
        }
      ]
    }
  ]
}
{% endschema %}