{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

{% liquid
  assign free_shipping_threshold_cents = settings.free_shipping_threshold | times: 100
  assign remaining_cents = free_shipping_threshold_cents | minus: cart.total_price
  assign free_shipping_unlocked = false
  if remaining_cents <= 0
    assign free_shipping_unlocked = true
  endif
  assign progress_percent = 100
  if free_shipping_threshold_cents > 0 and free_shipping_unlocked == false
    assign progress_percent = cart.total_price | times: 100 | divided_by: free_shipping_threshold_cents
  endif
%}

<div class="full-width j-page-hero-band">
  <div class="j-page-hero-band__inner">
    <div class="j-cart-page__header">

      <h1 class="j-cart-page__title">
        {{ 'cart.title' | t }}
      </h1>

      <span class="j-cart-page__count">
        {{ 'cart.item_count' | t: count: cart.item_count }}
      </span>

    </div>
  </div>
</div>

<div class="j-cart-page container {% if cart.item_count == 0 %}is-empty{% endif %}">

  {% if settings.free_shipping_threshold > 0 %}
    <div
      class="j-cart-page__shipping-bar {% if free_shipping_unlocked %}is-unlocked{% endif %}"
      data-free-shipping-threshold="{{ free_shipping_threshold_cents }}"
    >

      <p class="j-cart-page__shipping-message">
        {% if free_shipping_unlocked %}
          <span class="j-cart-page__shipping-emoji is-bursting">
            🎉
            <i class="j-spark"></i><i class="j-spark"></i><i class="j-spark"></i>
            <i class="j-spark"></i><i class="j-spark"></i><i class="j-spark"></i>
          </span> {{ 'cart.free_shipping_unlocked' | t }}
        {% else %}
          {% assign remaining_money = remaining_cents | money %}
          {{ 'cart.free_shipping_remaining_html' | t: amount: remaining_money }}
        {% endif %}
      </p>

      <div class="j-cart-page__shipping-track">
        <div
          class="j-cart-page__shipping-fill"
          style="width: {{ progress_percent }}%"
        ></div>
      </div>

    </div>
  {% endif %}

  <div class="j-cart-page__layout">

    <div
      class="j-cart-items j-cart-page__items"
      data-continue-shopping-url="{{ routes.all_products_collection_url }}"
    >
      {% if cart.item_count == 0 %}
        <p class="j-cart__empty">
          {{ 'cart.empty' | t }}
        </p>
        <a href="{{ routes.all_products_collection_url }}" class="j-button j-button-outline--gold j-cart__continue">
          {{ 'cart.continue_shopping' | t }}
        </a>
      {% else %}
        {% for item in cart.items %}
          {% render 'cart-item', item: item, priority: forloop.first %}
        {% endfor %}
      {% endif %}
    </div>

    <aside class="j-cart-page__summary">

      <h2>{{ 'cart.order_summary' | t }}</h2>

      <div class="j-cart__subtotal">

        <span>{{ 'cart.subtotal' | t }}</span>

        <strong class="j-cart-subtotal-value">
          {{ cart.total_price | money }}
        </strong>

      </div>

      {% if cart.cart_level_discount_applications.size > 0 %}
        <ul class="j-cart-page__discounts">
          {% for discount_application in cart.cart_level_discount_applications %}
            <li class="j-cart-page__discount">
              <span>{{ 'cart.discount' | t }} ({{ discount_application.title }})</span>
              <span>-{{ discount_application.total_allocated_amount | money }}</span>
            </li>
          {% endfor %}
        </ul>
      {% endif %}

      <p class="j-cart-page__note">
        {{ 'cart.taxes_note' | t }}
      </p>

      <form action="{{ routes.cart_url }}" method="get" class="j-cart-page__discount-form" id="CartDiscountForm">
        <label for="CartDiscountCode" class="visually-hidden">{{ 'cart.discount_code' | t }}</label>
        <input
          type="text"
          id="CartDiscountCode"
          name="discount_code"
          placeholder="{{ 'cart.discount_code' | t }}"
          autocomplete="off"
        >
        <button type="submit" class="j-button">{{ 'cart.apply_discount' | t }}</button>
      </form>

      {% form 'cart', cart %}
        <div class="j-cart-page__note-field">
          <label for="CartNote">{{ 'cart.notes' | t }}</label>
          <textarea
            id="CartNote"
            name="note"
            placeholder="{{ 'cart.notes_placeholder' | t }}"
          >{{ cart.note }}</textarea>
        </div>

        <input
          type="submit"
          name="checkout"
          class="j-button j-cart-checkout-button"
          value="{{ 'cart.checkout' | t }}"
          {% if cart.item_count == 0 %}disabled{% endif %}
        >

        {% if cart.item_count > 0 %}
          <div style="--shopify-payment-button-color-scheme: dark;">
            {{ form | payment_button }}
          </div>
        {% endif %}
      {% endform %}

      <p class="j-cart-page__secure">
        {{ 'icon-lock.svg' | inline_asset_content }}
        {{ 'cart.secure_checkout' | t }}
      </p>

      <a
        href="{{ routes.all_products_collection_url }}"
        class="j-cart-page__continue-link"
      >
        {{ 'cart.continue_shopping' | t }}
      </a>

    </aside>

  </div>

</div>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
