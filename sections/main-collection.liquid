{% comment %}
  Falls back to this section's own banner_image setting when the
  collection has none of its own — Shopify's auto-generated "All
  products" collection (usually at /collections/all) has no admin page
  reachable through the normal collection editor to ever set an image
  on directly, so without a fallback it could never show this banner
  treatment at all, only the plain text header below.
{% endcomment %}
{% assign banner_image = collection.image | default: section.settings.banner_image %}

<div class="full-width j-page-hero-band {% if banner_image %}j-page-hero-band--has-image{% endif %}">
  {% if banner_image %}
    <div class="j-page-hero-band__image">
      {% assign img_alt = banner_image.alt | default: collection.title %}
      {{
        banner_image
        | image_url: width: 1600, format: 'webp'
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '800, 1200, 1600',
          sizes: '100vw',
          alt: img_alt
      }}
    </div>
  {% endif %}

  {% comment %}
    A sibling of .j-page-hero-band__inner, not a child of it — rendered
    inside the band (on top of the photo when one is set) instead of as
    its own block above it, since a separate breadcrumb bar sitting
    between the white header and a full-bleed banner photo read as an
    unintentional gap/seam rather than one cohesive banner. Kept out of
    __inner specifically so it can be pinned near the very top of the
    band independent of __inner's own vertical centering (see
    .j-page-hero-band--has-image .j-breadcrumbs in base.css) — __inner
    only wraps the title block, whose vertical position is unrelated.
  {% endcomment %}
  {% render 'breadcrumbs' %}

  <div class="j-page-hero-band__inner">
    <div class="j-section-title">
      <h1>{{ collection.title }}</h1>

      {% if collection.description != blank %}
        <div class="rte">{{ collection.description }}</div>
      {% endif %}
    </div>
  </div>
</div>

<section class="j-collection">

  <div class="page-width">

    <div class="j-collection-layout">

      {% comment %}
        A collection with no filterable options (no product options,
        tags, or availability variance) previously still showed the
        Filters toggle and an empty-looking panel with just a heading
        and an inert Apply button — a dead-end control. Gating both the
        toggle and the panel on collection.filters != empty hides the
        whole affordance instead when there's genuinely nothing to
        filter by.
      {% endcomment %}
      {% if collection.filters != empty %}
        <aside class="j-collection-sidebar" id="CollectionFilters">

          {% render 'collection-filters' %}

        </aside>

        <div class="j-filter-overlay"></div>
      {% endif %}

      <div class="j-collection-content">

        <div class="j-collection-toolbar">
            {% if collection.filters != empty %}
              <button
                type="button"
                class="j-filter-toggle"
                aria-expanded="false"
                aria-controls="CollectionFilters"
              >
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M3 5h14M6 10h8M8.5 15h3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
                {{ 'filters.title' | t }}
              </button>
            {% endif %}

            <form id="CollectionSortForm">
              <label for="SortBy">
                {{ 'collection.sort_by' | t }}
              </label>

              <div class="j-collection-sort">

                <select
                  id="SortBy"
                  name="sort_by"
                >
                  {% for option in collection.sort_options %}

                    <option
                      value="{{ option.value }}"
                      {% if option.value == collection.sort_by %}
                        selected
                      {% endif %}
                    >
                      {{ option.name }}
                    </option>
                  {% endfor %}
                </select>

                <svg class="j-collection-sort__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>

              </div>
            </form>
          </div>

        <div class="j-collection-grid">

          {% comment %}
            Page links come straight from `paginate.parts`, which Shopify
            already windows around the current page (first page, neighbours,
            last page, with gaps). The cost of rendering them stays the same
            whether the collection has 3 pages or 3,000.
          {% endcomment %}
          {% paginate collection.products by section.settings.products_per_page, window_size: 2 %}
            {% if collection.products.size == 0 %}
              <p class="j-collection-empty">{{ 'collection.empty' | t }}</p>
            {% endif %}

            {% for product in collection.products %}

              {%- liquid
                assign card_eager = false
                if forloop.index <= 4
                  assign card_eager = true
                endif
                # One fetchpriority="high" per page: the banner image takes it when
                # there is one, otherwise the first product card does.
                assign card_priority = false
                if forloop.first and banner_image == blank
                  assign card_priority = true
                endif
              -%}
              {% render 'product-card', product: product, priority: card_priority, eager: card_eager %}

            {% endfor %}

            {% render 'pagination', paginate: paginate %}
          {% endpaginate %}

        </div>

      </div>

    </div>

  </div>

</section>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 12
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Fallback banner image",
      "info": "Used for the page banner only when a collection has no image of its own set in its admin page (this is the only way to give the auto-generated \"All\" collection a banner photo, since it has no image field of its own reachable through the collection editor)."
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}