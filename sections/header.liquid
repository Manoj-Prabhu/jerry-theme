{% render 'announcement-bar' %}

<header
  class="{% if section.settings.enable_sticky_header %}j-header--sticky{% endif %}"
>

  <button
    type="button"
    class="j-menu-toggle"
    aria-label="Open menu"
    aria-expanded="false"
    aria-controls="HeaderNav"
  >
    <span></span>
    <span></span>
    <span></span>
  </button>

  <h2 class="header__title">

    <a href="{{ routes.root_url }}" class="j-logo">

      {% if section.settings.logo != blank %}

        {% assign logo_style = 'width:' | append: section.settings.logo_width | append: 'px;height:auto;' %}

        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag:
            alt: shop.name,
            widths: '120,160,200,240,300,400',
            loading: 'eager',
            style: logo_style
        }}

      {% else %}

      {% assign words = shop.name | strip | split: ' ' %}

      {% if words.size > 1 %}
        <span class="j-logo-mark">{{ words[0] | slice: 0 | upcase }}{{ words[1] | slice: 0 | upcase }}</span>
      {% else %}
        <span class="j-logo-mark">{{ shop.name | slice: 0, 2 | upcase }}</span>
      {% endif %}

      {% endif %}

    </a>

  </h2>

  <div class="header__menu" id="HeaderNav">

    <button
      type="button"
      class="j-menu-close"
      aria-label="Close menu"
    >
      ✕
    </button>

    {% for link in section.settings.menu.links %}
      {% liquid
        assign is_mega_menu = false
        for column in link.links
          if column.links != blank
            assign is_mega_menu = true
          endif
        endfor
      %}

      <div class="j-nav-item{% if is_mega_menu %} j-nav-item--mega{% endif %}">
        <a
          href="{{ link.url }}"
          class="j-nav-link"
        >
          {{ link.title }}
          {% if link.links != blank %}
            <span class="j-nav-arrow">▾</span>
          {% endif %}
        </a>

        {% if is_mega_menu %}
          <div class="j-dropdown j-dropdown--mega">
            <div class="j-mega-menu">
              {% for column in link.links %}
                <div class="j-mega-menu__column">

                  <a
                    href="{{ column.url }}"
                    class="j-mega-menu__heading"
                  >
                    {{ column.title }}
                  </a>

                  {% if column.links != blank %}
                    <div class="j-mega-menu__links">
                      {% for grandchild in column.links %}
                        <a
                          href="{{ grandchild.url }}"
                          class="j-dropdown__link"
                        >
                          {{ grandchild.title }}
                        </a>
                      {% endfor %}
                    </div>
                  {% endif %}

                </div>
              {% endfor %}
            </div>
          </div>
        {% elsif link.links != blank %}
          <div class="j-dropdown">
            {% for childlink in link.links %}
              <a
                href="{{ childlink.url }}"
                class="j-dropdown__link"
              >
                {{ childlink.title }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="j-nav-overlay"></div>

  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="j-search-form"
    id="HeaderSearchForm"
  >

    <input
      type="search"
      name="q"
      placeholder="Search products..."
      autocomplete="off"
      id="PredictiveSearchInput"
    >

    <svg class="j-search-form__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>

    <div
      class="j-predictive-search"
      id="PredictiveSearchResults"
    ></div>

  </form>

  <div class="header__icons">

    <button
      type="button"
      class="j-header__search-toggle"
      aria-label="Search"
      aria-expanded="false"
      aria-controls="HeaderSearchForm"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
        <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <button
      type="button"
      class="j-header__wishlist"
      aria-label="Wishlist"
    >

      ♥

      <sup
        id="WishlistCount"
        hidden
      >
        0
      </sup>

    </button>

    <button
      type="button"
      class="j-header__cart"
      aria-label="Open cart"
    >

      {{ 'icon-cart.svg' | inline_asset_content }}

      <sup
        id="CartCount"
        {% if cart.item_count == 0 %}
          hidden
        {% endif %}
      >
        {{ cart.item_count }}
      </sup>

    </button>

  </div>

</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close button",
      "default": false
    },
    {
      "type": "color",
      "id": "announcement_background",
      "label": "Background color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "announcement_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon / Emoji",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Free shipping on orders over [amount]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "use_free_shipping_amount",
          "label": "Use free shipping amount",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}

<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>