{% render 'announcement-bar' %}
<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}" class="j-nav-link">
        {{ link.title }}
      </a>
    {% endfor %}
  </div>

  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="j-search-form"
  >

    <input
      type="search"
      name="q"
      placeholder="Search products..."
      autocomplete="off"
      id="PredictiveSearchInput"
    >

    <svg class="j-search-form__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>

    <div
      class="j-predictive-search"
      id="PredictiveSearchResults"
    ></div>

  </form>

  <div class="header__icons">

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <button
      type="button"
      class="j-header__wishlist"
      aria-label="Wishlist"
    >

      ♥

      <sup
        id="WishlistCount"
        hidden
      >
        0
      </sup>

    </button>

    <button
      type="button"
      class="j-header__cart"
      aria-label="Open cart"
    >

      {{ 'icon-cart.svg' | inline_asset_content }}

      <sup
        id="CartCount"
        {% if cart.item_count == 0 %}
          hidden
        {% endif %}
      >
        {{ cart.item_count }}
      </sup>

    </button>

  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement text",
      "default": "Free shipping on orders over $100"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement link"
    }
  ]
}
{% endschema %}

{{ 'predictive-search.js' | asset_url | script_tag }}
