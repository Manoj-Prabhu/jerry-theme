{% render 'announcement-bar' %}
<header>
  <h2 class="header__title">
    {{ shop.name | link_to: routes.root_url }}
  </h2>

  <div class="header__menu">
    {% for link in section.settings.menu.links %}
      <a href="{{ link.url }}" class="j-nav-link">
        {{ link.title }}
      </a>
    {% endfor %}
  </div>

  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="j-search-form"
  >

    <input
      type="search"
      name="q"
      placeholder="Search products..."
      autocomplete="off"
      id="PredictiveSearchInput"
    >

    <svg class="j-search-form__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>

    <div
      class="j-predictive-search"
      id="PredictiveSearchResults"
    ></div>

  </form>

  <div class="header__icons">

    {% if shop.customer_accounts_enabled %}
      <shopify-account menu="{{ section.settings.customer_account_menu }}">
        {{ 'icon-account.svg' | inline_asset_content }}
      </shopify-account>
    {% endif %}

    <button
      type="button"
      class="j-header__wishlist"
      aria-label="Wishlist"
    >

      ♥

      <sup
        id="WishlistCount"
        hidden
      >
        0
      </sup>

    </button>

    <button
      type="button"
      class="j-header__cart"
      aria-label="Open cart"
    >

      {{ 'icon-cart.svg' | inline_asset_content }}

      <sup
        id="CartCount"
        {% if cart.item_count == 0 %}
          hidden
        {% endif %}
      >
        {{ cart.item_count }}
      </sup>

    </button>

  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto rotate announcements",
      "default": true
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "sec",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close button",
      "default": false
    },
    {
      "type": "color",
      "id": "announcement_background",
      "label": "Background color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "announcement_alignment",
      "label": "Text alignment",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    }
  ],
  "blocks": [
  {
    "type": "announcement",
    "name": "Announcement",
    "settings": [
      {
        "type": "text",
        "id": "icon",
        "label": "Icon / Emoji",
        "default": "🚚"
      },
      {
        "type": "text",
        "id": "text",
        "label": "Announcement text",
        "default": "Free shipping on orders over [amount]"
      },
      {
        "type": "url",
        "id": "link",
        "label": "Link"
      },
      {
        "type": "checkbox",
        "id": "use_free_shipping_amount",
        "label": "Use free shipping amount",
        "default": false
      }
    ]
  }
],
"max_blocks": 5
}
{% endschema %}

{{ 'predictive-search.js' | asset_url | script_tag }}
