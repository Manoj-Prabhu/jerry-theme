{% render 'announcement-bar' %}

{% style %}
  {{ section.settings.nav_font | font_face: font_display: 'swap' }}

  #shopify-section-{{ section.id }} .j-nav-link {
    font-family: {{ section.settings.nav_font.family }}, {{ section.settings.nav_font.fallback_families }};
    font-style: {{ section.settings.nav_font.style }};
    font-weight: {{ section.settings.nav_font.weight }};
  }
{% endstyle %}

<header
  class="j-site-header-wrapper full-width {% if section.settings.enable_sticky_header %}j-header--sticky{% endif %}"
>
  <div class="j-site-header">

  {% if section.settings.menu.links != blank %}
    <button
      type="button"
      class="j-menu-toggle"
      aria-label="{{ 'header.menu_open' | t }}"
      aria-expanded="false"
      aria-controls="HeaderNav"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>
  {% endif %}

  <h2 class="header__title">

    <a href="{{ routes.root_url }}" class="j-logo">

      {% if section.settings.logo != blank %}

        {% assign logo_style = 'width:' | append: section.settings.logo_width | append: 'px;height:auto;' %}
        {% assign logo_sizes = section.settings.logo_width | append: 'px' %}

        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag:
            alt: shop.name,
            widths: '120,160,200,240,300,400',
            sizes: logo_sizes,
            loading: 'eager',
            preload: true,
            style: logo_style
        }}

      {% else %}

      {% assign words = shop.name | strip | split: ' ' %}

      {% if words.size > 1 %}
        <span class="j-logo-mark">{{ words[0] | slice: 0 | upcase }}{{ words[1] | slice: 0 | upcase }}</span>
      {% else %}
        <span class="j-logo-mark">{{ shop.name | slice: 0, 2 | upcase }}</span>
      {% endif %}

      {% endif %}

    </a>

  </h2>

  <div class="header__menu" id="HeaderNav">

    <button
      type="button"
      class="j-menu-close"
      aria-label="{{ 'header.menu_close' | t }}"
    >
      ✕
    </button>

    {% for link in section.settings.menu.links %}
      {% liquid
        assign is_mega_menu = false
        for column in link.links
          if column.links != blank or column.type == 'collection_link'
            assign is_mega_menu = true
          endif
        endfor
      %}

      <div class="j-nav-item{% if is_mega_menu %} j-nav-item--mega{% endif %}">
        <a
          href="{{ link.url }}"
          class="j-nav-link"
          {% if link.links != blank %}
            aria-haspopup="true"
            aria-expanded="false"
          {% endif %}
        >
          {{ link.title }}
          {% if link.links != blank %}
            <span class="j-nav-arrow">▾</span>
          {% endif %}
        </a>

        {% if is_mega_menu %}
          <div class="j-dropdown j-dropdown--mega">
            <div class="j-mega-menu">
              {% for column in link.links %}
                <a href="{{ column.url }}" class="j-mega-menu__tile">

                  {% if column.type == 'collection_link' and column.object.featured_image %}
                    {{
                      column.object.featured_image
                      | image_url: width: 600
                      | image_tag:
                        widths: '300, 450, 600',
                        sizes: '(max-width: 992px) 45vw, 300px',
                        loading: 'lazy',
                        alt: column.title,
                        class: 'j-mega-menu__tile-image'
                    }}
                  {% else %}
                    <span class="j-mega-menu__tile-image j-mega-menu__tile-image--placeholder" aria-hidden="true"></span>
                  {% endif %}

                  <span class="j-mega-menu__tile-caption">
                    <span class="j-mega-menu__tile-title">{{ column.title }}</span>
                    <span class="j-mega-menu__tile-cta">{{ 'header.shop_now' | t }}</span>
                  </span>

                </a>
              {% endfor %}
            </div>
          </div>
        {% elsif link.links != blank %}
          <div class="j-dropdown">
            {% for childlink in link.links %}
              <a
                href="{{ childlink.url }}"
                class="j-dropdown__link"
              >
                {{ childlink.title }}
              </a>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
  </div>

  <div class="j-nav-overlay"></div>

  <form
    action="{{ routes.search_url }}"
    method="get"
    role="search"
    class="j-search-form"
    id="HeaderSearchForm"
  >

    <input type="hidden" name="type" value="product">

    <input
      type="search"
      name="q"
      placeholder="{{ 'header.search_placeholder' | t }}"
      autocomplete="off"
      id="PredictiveSearchInput"
      role="combobox"
      aria-expanded="false"
      aria-controls="PredictiveSearchResults"
      aria-autocomplete="list"
      aria-haspopup="listbox"
    >

    <svg class="j-search-form__icon" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
      <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
    </svg>

    <div
      class="j-predictive-search"
      id="PredictiveSearchResults"
      role="listbox"
      aria-live="polite"
    ></div>

  </form>

  <div class="header__icons">

    <button
      type="button"
      class="j-header__search-toggle"
      aria-label="{{ 'header.search' | t }}"
      aria-expanded="false"
      aria-controls="HeaderSearchForm"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.6"/>
        <path d="M18 18L14 14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
      </svg>
    </button>

    {% if shop.customer_accounts_enabled %}
      <shopify-account
        menu="customer-account-main-menu"
        class="j-header__account"
        aria-label="{{ 'header.account' | t }}"
      >
        <div slot="signed-out-avatar" class="j-header__account-icon">
          {{ 'icon-account.svg' | inline_asset_content }}
        </div>
      </shopify-account>
    {% endif %}

    <button
      type="button"
      class="j-header__wishlist"
      aria-label="{{ 'header.wishlist' | t }}"
    >

      ♥

      <sup
        id="WishlistCount"
        aria-live="polite"
        hidden
      >
        0
      </sup>

    </button>

    <button
      type="button"
      class="j-header__cart"
      aria-label="{{ 'header.cart_open' | t }}"
      aria-expanded="false"
      aria-controls="CartDrawer"
    >

      {{ 'icon-cart.svg' | inline_asset_content }}

      <sup
        id="CartCount"
        aria-live="polite"
        {% if cart.item_count == 0 %}
          hidden
        {% endif %}
      >
        {{ cart.item_count }}
      </sup>

    </button>

  </div>

  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 160
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_header",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "font_picker",
      "id": "nav_font",
      "label": "Navigation font",
      "info": "Used for the main menu links (Home, Catalog, Men, Women, etc).",
      "default": "fredoka_n4"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show announcement bar",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Show close button",
      "info": "Lets customers dismiss the announcement bar for their session.",
      "default": false
    },
    {
      "type": "color",
      "id": "announcement_background",
      "label": "Background color",
      "default": "#14110F"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "font_picker",
      "id": "announcement_font",
      "label": "Announcement font",
      "default": "fredoka_n4"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement text",
          "default": "Free shipping on orders over [amount]"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "use_free_shipping_amount",
          "label": "Show free shipping amount",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 5
}
{% endschema %}

<script src="{{ 'predictive-search.js' | asset_url }}" defer="defer"></script>