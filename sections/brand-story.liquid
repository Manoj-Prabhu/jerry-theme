{%- assign section_settings = section.settings -%}
{% comment %}
  Brand Story — editorial image + narrative block, with an optional row
  of stats (e.g. "Est. 2020", "40+ Countries"). Sits between Featured
  Collection and Testimonials on the homepage.

  The image side supports up to 4 "Image" blocks — with 2+ added, it
  becomes an auto-rotating crossfade slideshow (see brand-story.js);
  with 0 or 1, it just renders as a static image/placeholder.
{% endcomment %}

{% liquid
  assign image_blocks = section.blocks | where: 'type', 'image'
  assign stat_blocks = section.blocks | where: 'type', 'stat'
%}

<section class="j-brand-story full-width">
  <div class="j-brand-story__inner j-brand-story__inner--{{ section_settings.image_position }}">

    <div
      class="j-brand-story__media"
      {% if image_blocks.size > 1 %}
        data-slideshow
        data-slideshow-autoplay="{{ section_settings.autoplay_speed | times: 1000 }}"
      {% endif %}
    >
      {% if image_blocks.size > 0 %}
        {% for block in image_blocks %}
          {% assign block_settings = block.settings %}
          {% if block_settings.image != blank %}
            <div
              class="j-brand-story__slide{% if forloop.first %} is-active{% endif %}"
              {% unless forloop.first %}aria-hidden="true" inert{% endunless %}
              {{ block.shopify_attributes }}
            >
              {% assign img_alt = section_settings.heading | default: shop.name %}
              {%- liquid
                assign slide_loading = 'lazy'
                if forloop.first
                  assign slide_loading = 'eager'
                endif
                # Written as a positive "not at the top" test so the editor and Section
                # Rendering API, where section.index is nil, keep the image eager.
                if section.index > 1 or section.location == 'footer'
                  assign slide_loading = 'lazy'
                endif
              -%}
              {{
                block_settings.image
                | image_url: width: 1200, format: 'webp'
                | image_tag: loading: slide_loading, widths: '480, 600, 768, 1000, 1200', sizes: '(max-width: 480px) 75vw, (max-width: 900px) 88vw, 42vw', class: 'j-brand-story__image', alt: img_alt
              }}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        <div class="j-brand-story__media-placeholder">{{ 'image' | placeholder_svg_tag: 'j-brand-story__placeholder-svg' }}</div>
      {% endif %}
    </div>

    <div class="j-brand-story__content">

      {% if section_settings.eyebrow != blank %}
        <span class="j-brand-story__eyebrow">{{ section_settings.eyebrow }}</span>
      {% endif %}

      {% if section_settings.heading != blank %}
        <h2 class="j-brand-story__heading">{{ section_settings.heading }}</h2>
      {% endif %}

      {% if section_settings.body != blank %}
        <div class="j-brand-story__body">{{ section_settings.body }}</div>
      {% endif %}

      {% if stat_blocks.size > 0 %}
        <div class="j-brand-story__stats">
          {% for block in stat_blocks %}
            {% assign block_settings = block.settings %}
            <div class="j-brand-story__stat" {{ block.shopify_attributes }}>
              <span class="j-brand-story__stat-number">{{ block_settings.number }}</span>
              <span class="j-brand-story__stat-label">{{ block_settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section_settings.button_label != blank %}
        {% comment %}
          The visually-hidden suffix makes the link text descriptive on its
          own — "Learn More" alone is flagged by Lighthouse's "Links do not
          have descriptive text" (its audit reads the link's text content and
          ignores aria-label), and screen reader users often scan a page's
          links in isolation. The visible button keeps its shorter label.
        {% endcomment %}
        <a
          href="{{ section_settings.button_link | default: '#' }}"
          class="j-button j-button-outline j-brand-story__button"
        >
          {{ section_settings.button_label }}<span class="visually-hidden"> about {{ shop.name }}</span>
        </a>
      {% endif %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Slideshow speed (seconds)",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "Only used when 2 or more Image blocks are added."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted With Purpose"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>What started as a small idea has grown into a collection built on care, quality, and craftsmanship. Every piece is chosen thoughtfully, made to last, and designed for the way you actually live.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "2020"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Est."
        }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Brand story",
      "blocks": [
        { "type": "image" },
        { "type": "stat", "settings": { "number": "2020", "label": "Est." } },
        { "type": "stat", "settings": { "number": "40+", "label": "Countries" } },
        { "type": "stat", "settings": { "number": "10K+", "label": "Happy Customers" } }
      ]
    }
  ]
}
{% endschema %}
