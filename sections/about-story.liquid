{%- assign section_settings = section.settings -%}
{% comment %}
  About page — image + narrative block with an optional row of stats.
  Same visual language as the homepage's Brand Story section (gold-framed
  image, gold eyebrow/stats/button), but a separate, self-contained
  section — About-page CSS only loads for template.suffix == 'about' (see
  layout/theme.liquid), so this can't share the homepage section's
  instance without also loading brand-story.css on every page.
{% endcomment %}

{% liquid
  assign stat_blocks = section.blocks | where: 'type', 'stat'
%}

<section class="j-about-story full-width">
  <div class="j-about-story__inner j-about-story__inner--{{ section_settings.image_position }}">

    <div class="j-about-story__media">
      {% if section_settings.image != blank %}
        {% assign img_alt = section_settings.heading | default: shop.name %}
        {%- liquid
          assign story_loading = 'eager'
          if section.index > 3 or section.location == 'footer'
            assign story_loading = 'lazy'
          endif
        -%}
        {{
          section_settings.image
          | image_url: width: 1200, format: 'webp'
          | image_tag: loading: story_loading, widths: '480, 768, 1000, 1200', sizes: '(max-width: 900px) 100vw, 50vw', class: 'j-about-story__image', alt: img_alt
        }}
      {% else %}
        <div class="j-about-story__media-placeholder">{{ 'image' | placeholder_svg_tag: 'j-about-story__placeholder-svg' }}</div>
      {% endif %}
    </div>

    <div class="j-about-story__content">

      {% if section_settings.eyebrow != blank %}
        <span class="j-about-story__eyebrow">{{ section_settings.eyebrow }}</span>
      {% endif %}

      {% if section_settings.heading != blank %}
        <h2 class="j-about-story__heading">{{ section_settings.heading }}</h2>
      {% endif %}

      {% if section_settings.body != blank %}
        <div class="j-about-story__body">{{ section_settings.body }}</div>
      {% endif %}

      {% if stat_blocks.size > 0 %}
        <div class="j-about-story__stats">
          {% for block in stat_blocks %}
            {% assign block_settings = block.settings %}
            <div class="j-about-story__stat" {{ block.shopify_attributes }}>
              <span class="j-about-story__stat-number">{{ block_settings.number }}</span>
              <span class="j-about-story__stat-label">{{ block_settings.label }}</span>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section_settings.button_label != blank %}
        <a
          href="{{ section_settings.button_link | default: '#' }}"
          class="j-button j-button-outline--gold j-about-story__button"
          aria-label="{{ section_settings.button_label }} at {{ shop.name }}"
        >
          {{ section_settings.button_label }}
        </a>
      {% endif %}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "About story",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "How We Started"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From a Small Idea to a Studio"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text",
      "default": "<p>It began with a simple frustration: too many everyday products were built to be replaced, not kept. We set out to make the opposite — pieces chosen for their materials, their maker, and how they hold up years later.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "2020"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Est."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "About story",
      "blocks": [
        { "type": "stat", "settings": { "number": "2020", "label": "Est." } },
        { "type": "stat", "settings": { "number": "40+", "label": "Countries" } },
        { "type": "stat", "settings": { "number": "10K+", "label": "Happy Customers" } }
      ]
    }
  ]
}
{% endschema %}
