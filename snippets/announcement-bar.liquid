{% comment %}
  Jerry Announcement Bar
{% endcomment %}

{% if section.settings.show_announcement %}
  {% liquid
    assign free_shipping_amount = settings.free_shipping_threshold | times: 100 | money_without_trailing_zeros
    assign announcement_text = section.settings.announcement_text | replace: '[amount]', free_shipping_amount
  %}

  <div class="j-announcement full-width">
    <div class="container">
      {% if section.settings.announcement_link != blank %}
        <a
          href="{{ section.settings.announcement_link }}"
          class="j-announcement__text"
        >
          {{ announcement_text }}
        </a>
      {% else %}
        <span class="j-announcement__text">
          {{ announcement_text }}
        </span>
      {% endif %}
    </div>
  </div>
{% endif %}