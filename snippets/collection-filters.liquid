{% comment %}
  Shared filter panel for both collection pages (sections/main-collection.liquid)
  and the search results page (sections/search.liquid) — Shopify's `search`
  object exposes the same filters/sort_by/results_count shape as `collection`
  when performed with type=product, so this snippet accepts them as explicit
  parameters instead of assuming a `collection` object is in scope.

  Accepts:
  - filters: a filters array (collection.filters or search.filters)
  - sort_by: the current sort value (collection.sort_by or search.sort_by)
  - clear_url: URL to reset all filters (collection.url or the search page's base URL)
{% endcomment %}

{% liquid
  assign filters = filters | default: collection.filters
  assign sort_by = sort_by | default: collection.sort_by
  assign clear_url = clear_url | default: collection.url
%}

<div class="j-collection-filters">

  <div class="j-collection-filters__header">

    <h2>{{ 'filters.title' | t }}</h2>

    <div class="j-collection-filters__header-actions">

      {% if filters != empty %}
        {% assign has_active_filters = false %}
        {% for filter in filters %}
          {% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}
            {% assign has_active_filters = true %}
          {% endif %}
        {% endfor %}

        {% if has_active_filters %}
          <a href="{{ clear_url }}" class="j-collection-filters__clear">
            {{ 'filters.clear_all' | t }}
          </a>
        {% endif %}
      {% endif %}

      <button
        type="button"
        class="j-collection-filters__close"
        aria-label="{{ 'filters.close' | t }}"
      >
        ✕
      </button>

    </div>

  </div>

  <form id="CollectionFiltersForm">

    {% if sort_by %}
      <input
        type="hidden"
        name="sort_by"
        value="{{ sort_by }}"
      >
    {% endif %}

    {% comment %}
      This form has no action, so it self-submits (GET) to the current
      URL — on the search page that would otherwise drop the search term
      and type params, since native form submission replaces the whole
      query string rather than merging with it.
    {% endcomment %}
    {% if search.performed %}
      <input type="hidden" name="q" value="{{ search.terms | escape }}">
      <input type="hidden" name="type" value="product">
    {% endif %}

    {% for filter in filters %}

      {% assign filter_is_active = false %}
      {% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}
        {% assign filter_is_active = true %}
      {% endif %}

      <details class="j-filter" {% if filter_is_active %}open{% endif %}>

        <summary>
          {{ filter.label }}
        </summary>

        <div class="j-filter__values">

          {% case filter.type %}

            {% when 'list', 'boolean' %}

              {% for value in filter.values %}

                <label class="j-filter__option">

                  <input
                    type="checkbox"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}checked{% endif %}
                  >

                  <span class="j-filter__option-label">{{ value.label }}</span>
                  <span class="j-filter__option-count">{{ value.count }}</span>

                </label>

              {% endfor %}

            {% when 'price_range' %}

              <div class="j-filter__price-range">

                <div class="j-filter__price-input">
                  <span>{{ cart.currency.symbol }}</span>
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    placeholder="{{ 'filters.min' | t }}"
                    value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"
                  >
                </div>

                <span class="j-filter__price-separator">{{ 'filters.to' | t }}</span>

                <div class="j-filter__price-input">
                  <span>{{ cart.currency.symbol }}</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    placeholder="{{ 'filters.max' | t }}"
                    value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"
                  >
                </div>

              </div>

          {% endcase %}

        </div>

      </details>

    {% endfor %}

    <button
      type="submit"
      class="j-button j-collection-filters__apply"
    >
      {{ 'filters.apply' | t }}
    </button>

  </form>

</div>
