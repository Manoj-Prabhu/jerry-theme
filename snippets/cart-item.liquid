{% comment %}
  Renders a single cart line item. Used for the server-rendered initial
  state of both the cart page and cart drawer (sections/cart.liquid,
  sections/cart-drawer.liquid) — assets/cart.js re-renders this same
  markup client-side after quantity/remove actions, so keep both in sync.

  Accepts:
  - item: a cart line item object
  - priority: true for the first item, to mark its image as the LCP
    candidate (fetchpriority="high")
{% endcomment %}

<div class="j-cart-item{% unless item.variant.available %} is-unavailable{% endunless %}">

  {% liquid
    assign cart_item_loading = 'lazy'
    assign cart_item_fetchpriority = 'auto'
    assign cart_item_preload = false
    if priority
      assign cart_item_loading = 'eager'
      assign cart_item_fetchpriority = 'high'
      assign cart_item_preload = true
    endif
  %}

  {% comment %}
    preload: true on the first (LCP) item — Lighthouse's "LCP breakdown"
    showed this image's "Resource load delay" (840ms) dwarfing its actual
    load time (230ms): eager + fetchpriority="high" raise its priority
    once discovered, but the browser still has to reach and parse this
    far into the body first. A <link rel="preload"> (the same idiomatic
    image_tag argument sections/header.liquid already uses for the logo)
    makes the browser discover and start fetching it immediately, instead
    of waiting on normal HTML parsing to get here.
  {% endcomment %}
  <div class="j-cart-item__image">
    {{
      item.image
      | image_url: width: 160, format: 'webp'
      | image_tag:
        alt: item.product.title,
        width: 80,
        height: 80,
        widths: '80, 120, 160',
        sizes: '80px',
        loading: cart_item_loading,
        fetchpriority: cart_item_fetchpriority,
        preload: cart_item_preload
    }}
  </div>

  <div class="j-cart-item__content">

    <div class="j-cart-item__top">
      <div>
        <p class="j-cart-item__title">{{ item.product.title }}</p>

        {% unless item.product.has_only_default_variant %}
          <ul class="j-cart-item__options">
            {% for option in item.options_with_values %}
              <li>{{ option.name }}: {{ option.value }}</li>
            {% endfor %}
          </ul>
        {% endunless %}

        {% if item.selling_plan_allocation %}
          <p class="j-cart-item__selling-plan">{{ item.selling_plan_allocation.selling_plan.name }}</p>
        {% endif %}

        {% comment %}
          A line item's variant can go out of stock after it's already
          been added to cart (someone else buys the last one, a merchant
          disables it, etc.) — previously this rendered with no
          indication at all, so a shopper wouldn't find out until
          checkout rejected it. item.variant is a full Variant object
          here (this is the Liquid-rendered path — sections/cart.liquid /
          cart-drawer.liquid), unlike the Cart API's JSON line-item
          resource, which doesn't expose availability; assets/cart.js's
          client-side re-render after a quantity change can't check this
          without an extra request, so it's unchanged there. A fresh
          cart page load or drawer open (the common case) always goes
          through this snippet, so this still covers the scenario that
          matters most.
        {% endcomment %}
        {% unless item.variant.available %}
          <p class="j-cart-item__unavailable">{{ 'cart.item_unavailable' | t }}</p>
        {% endunless %}
      </div>

      <button
        class="j-cart-remove"
        data-key="{{ item.key }}"
        aria-label="{{ 'cart.remove_item_html' | t: title: item.product.title | escape }}"
      >
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path
            d="M4 7h16M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2m-9 0 1 13a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-13"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </button>
    </div>

    <p>
      {% if item.original_price > item.final_price %}
        <s class="j-cart-item__original-price">{{ item.original_price | money }}</s>
      {% endif %}
      {{ item.final_price | money }}
    </p>

    {% if item.unit_price_measurement %}
      <p class="j-cart-item__unit-price">
        {{ item.unit_price | unit_price_with_measurement: item.unit_price_measurement }}
      </p>
    {% endif %}

    {% if item.line_level_discount_allocations.size > 0 %}
      <ul class="j-cart-item__discounts">
        {% for discount_allocation in item.line_level_discount_allocations %}
          <li>
            {{ discount_allocation.discount_application.title }} (-{{ discount_allocation.amount | money }})
          </li>
        {% endfor %}
      </ul>
    {% endif %}

    <div class="j-cart-item__quantity">

      <button
        class="j-cart-qty-minus"
        data-key="{{ item.key }}"
        data-quantity="{{ item.quantity }}"
        aria-label="{{ 'cart.decrease_quantity' | t }}"
        {% unless item.variant.available %}disabled{% endunless %}
      >
        −
      </button>

      <span class="j-cart-item-qty">{{ item.quantity }}</span>

      <button
        class="j-cart-qty-plus"
        data-key="{{ item.key }}"
        data-quantity="{{ item.quantity }}"
        aria-label="{{ 'cart.increase_quantity' | t }}"
        {% unless item.variant.available %}disabled{% endunless %}
      >
        +
      </button>

    </div>

  </div>

</div>
