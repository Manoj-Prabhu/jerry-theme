<div class="j-cart-item">

  <div class="j-cart-item__image">

    {{
      item.image
      | image_url: width: 150
      | image_tag
    }}

  </div>

  <div class="j-cart-item__content">

    <h4>{{ item.product.title }}</h4>

    <p>{{ item.final_price | money }}</p>

    <span>
      Qty: {{ item.quantity }}
    </span>

  </div>

</div>