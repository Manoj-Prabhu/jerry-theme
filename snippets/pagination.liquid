{% comment %}
  Page navigation for any paginated list: previous / next arrows around the
  page links Shopify windows for us in `paginate.parts` (first page,
  neighbours of the current page, last page, with gaps).

  Usage, inside a {% paginate %} block:
  {% render 'pagination', paginate: paginate %}
{% endcomment %}

{% if paginate.pages > 1 %}
  <nav class="j-pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t: default: 'Pagination' }}">
    {% if paginate.previous %}
      <a
        href="{{ paginate.previous.url }}"
        class="j-pagination__arrow j-pagination__arrow--prev"
        aria-label="{{ 'general.pagination.prev' | t }}"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span aria-hidden="true">{{ 'general.pagination.prev' | t }}</span>
      </a>
    {% else %}
      <span
        class="j-pagination__arrow j-pagination__arrow--prev is-disabled"
        role="link"
        aria-disabled="true"
        aria-label="{{ 'general.pagination.prev' | t }}"
      >
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M12.5 15 7.5 10l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span aria-hidden="true">{{ 'general.pagination.prev' | t }}</span>
      </span>
    {% endif %}

    {% assign current_title = paginate.current_page | append: '' %}

    <ul class="j-pagination__list">
      {% for part in paginate.parts %}
        {% assign part_title = part.title | append: '' %}
        <li>
          {% if part.is_link %}
            <a href="{{ part.url }}" class="j-pagination__item">{{ part.title }}</a>
          {% elsif part_title == current_title %}
            <span class="j-pagination__item j-pagination__item--current" aria-current="page">{{ part.title }}</span>
          {% else %}
            <span class="j-pagination__item j-pagination__item--gap">{{ part.title }}</span>
          {% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if paginate.next %}
      <a
        href="{{ paginate.next.url }}"
        class="j-pagination__arrow j-pagination__arrow--next"
        aria-label="{{ 'general.pagination.next' | t }}"
      >
        <span aria-hidden="true">{{ 'general.pagination.next' | t }}</span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 5 12.5 10l-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    {% else %}
      <span
        class="j-pagination__arrow j-pagination__arrow--next is-disabled"
        role="link"
        aria-disabled="true"
        aria-label="{{ 'general.pagination.next' | t }}"
      >
        <span aria-hidden="true">{{ 'general.pagination.next' | t }}</span>
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M7.5 5 12.5 10l-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
    {% endif %}
  </nav>
{% endif %}
