{% comment %}
  Renders the hero's trust row (e.g. Free Shipping / Easy Returns / Secure
  Checkout). Accepts:
  - trust_blocks: section.blocks filtered to type 'trust_item'
{% endcomment %}

{% if trust_blocks.size > 0 %}
  <div class="j-hero__trust">
    {% for block in trust_blocks %}
      <div class="j-hero__trust-item" {{ block.shopify_attributes }}>
        <span class="j-hero__trust-icon" aria-hidden="true">
          {% case block.settings.icon %}
            {% when 'shipping' %}
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M2 5.5h9v8H2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                <path d="M11 8.5h3.5L17 11v2.5h-6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                <circle cx="6" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.4"/>
                <circle cx="14" cy="14.5" r="1.5" stroke="currentColor" stroke-width="1.4"/>
              </svg>
            {% when 'returns' %}
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M3.5 10a6.5 6.5 0 1 1 1.9 4.6" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                <path d="M3.5 6v4h4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            {% when 'quality' %}
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M10 2.5 12.2 7l5 .7-3.6 3.5.9 5-4.5-2.4L5.5 16.2l.9-5-3.6-3.5 5-.7Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
              </svg>
            {% else %}
              <svg viewBox="0 0 20 20" fill="none">
                <path d="M10 2.5 16 4.5v4c0 4.2-2.6 7.2-6 8.5-3.4-1.3-6-4.3-6-8.5v-4L10 2.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                <path d="M7.3 9.8 9.2 11.7 12.8 8" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
          {% endcase %}
        </span>
        <span>{{ block.settings.text }}</span>
      </div>
    {% endfor %}
  </div>
{% endif %}
