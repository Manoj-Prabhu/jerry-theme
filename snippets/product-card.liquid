<div class="j-product-card">

  <div class="j-product-card__image"{% if product.images.size > 1 %} data-auto-cycle{% endif %}>

    {% comment %}
      A <button> can't be nested inside an <a> per the HTML spec (invalid
      interactive-in-interactive content) — the wishlist/quick-view
      buttons below need to sit alongside the images, not inside a link
      wrapping them. This anchor still makes the image itself clickable
      (display: contents means it generates no box of its own, so its
      children — the <img> tags — lay out exactly as if it weren't
      there, while still functioning as a real, focusable link), and is
      hidden from assistive tech since the card's real accessible link
      is the title below.
    {% endcomment %}
    <a
      href="{{ product.url }}"
      class="j-product-card__image-link"
      tabindex="-1"
      aria-hidden="true"
    >

      {% if product.featured_image %}

        {% assign card_images = product.images | slice: 0, 4 %}

        {% for card_image in card_images %}
          {% if forloop.first %}
            {% assign img_class = 'j-product-card__img is-active' %}
          {% else %}
            {% assign img_class = 'j-product-card__img' %}
          {% endif %}

          {% comment %}
            widths' 500 -> 700 jump: at the mobile/tablet sizes branch
            (<=1100px, 50vw) this grid's real card width lands around
            514-526px on plenty of common desktop/laptop window widths
            (~1024-1100px) — just short of 500, so the browser had
            nothing between 500 and 700 to pick and always overshot
            straight to 700 (flagged by Lighthouse's "Improve image
            delivery": ~700x700 fetched for a ~514x514 display). Added
            600 to close that gap.
          {% endcomment %}
          {% if forloop.first and priority %}
            {% assign img_alt = card_image.alt | default: product.title %}
            {{
              card_image
              | image_url: width: 700, format: 'webp'
              | image_tag:
                class: img_class,
                alt: img_alt,
                widths: '200, 350, 500, 600, 700',
                sizes: '(max-width: 1100px) 50vw, 25vw',
                fetchpriority: 'high'
            }}
          {% else %}
            {% assign img_alt = card_image.alt | default: product.title %}
            {% comment %}
              `eager` is passed for the first few cards of a grid that sits
              at the top of the page — those are visible in the initial
              viewport, so they must not be lazy-loaded.
            {% endcomment %}
            {% assign card_loading = 'lazy' %}
            {% if eager and forloop.first %}
              {% assign card_loading = 'eager' %}
            {% endif %}
            {% capture card_image_tag %}
              {{
                card_image
                | image_url: width: 700, format: 'webp'
                | image_tag:
                  loading: card_loading,
                  class: img_class,
                  alt: img_alt,
                  widths: '200, 350, 500, 600, 700',
                  sizes: '(max-width: 1100px) 50vw, 25vw'
              }}
            {% endcapture %}
            {% if forloop.first %}
              {{ card_image_tag }}
            {% else %}
              {% comment %}
                The 2nd-4th images only ever appear when the card auto-cycles
                (see JerryProductCardCycle in theme.js). They're stacked in the
                same box as the first, so loading="lazy" never held them back —
                a grid of 8 products fetched up to 32 images on page load, most
                of them invisible. Withholding src/srcset (as data-src /
                data-srcset) leaves them unfetched until the cycle is about to
                show them.
              {% endcomment %}
              {{ card_image_tag | replace: ' src=', ' data-src=' | replace: ' srcset=', ' data-srcset=' }}
            {% endif %}
          {% endif %}
        {% endfor %}

      {% else %}

        {{ 'product-1' | placeholder_svg_tag }}

      {% endif %}

    </a>

    {% render 'product-badges', product: product %}

      <button
        type="button"
        class="j-wishlist-button"
        data-handle="{{ product.handle }}"
        data-product-title="{{ product.title | escape }}"
        aria-label="{{ 'product.add_to_wishlist_html' | t: title: product.title | escape }}"
        aria-pressed="false"
      >
        ♡
      </button>

      {% unless show_quick_view == false %}
        <button
          type="button"
          class="j-quick-view-button"
          data-handle="{{ product.handle }}"
          aria-haspopup="dialog"
        >
          {{ 'product.quick_view' | t }}
        </button>
      {% endunless %}

    </div>

  <a href="{{ product.url }}" class="j-product-card__link">
    <div class="j-product-card__content">

      <h2>{{ product.title }}</h2>

      {% comment %}
        The rating metafields are only read when ratings are switched on in
        Theme settings > Product cards, so a store that doesn't use them pays
        no lookup per card.
      {% endcomment %}
      {% assign rating = null %}
      {% if settings.show_product_rating %}
        {% assign rating = product.metafields.custom.rating.value %}
      {% endif %}
      {% if rating %}
        {% assign rating_count = product.metafields.custom.rating_count.value %}
        <div class="j-product-card__rating">
          <span class="visually-hidden">
            {{ 'product.rating_label_html' | t: rating: rating.rating }}
            {% if rating_count %}
              ({{ 'product.rating_count' | t: count: rating_count }})
            {% endif %}
          </span>
          <span class="j-product-card__stars" aria-hidden="true">
            {% for i in (1..5) %}
              {% assign star_fill = rating.rating | minus: forloop.index0 %}
              {% if star_fill > 1 %}
                {% assign star_fill = 1 %}
              {% elsif star_fill < 0 %}
                {% assign star_fill = 0 %}
              {% endif %}
              {% assign star_fill_percent = star_fill | times: 100 %}
              <span class="j-star" style="--fill: {{ star_fill_percent }}%;">★</span>
            {% endfor %}
          </span>
          {% if rating_count %}
            <span class="j-product-card__rating-count" aria-hidden="true">({{ rating_count }})</span>
          {% endif %}
        </div>
      {% endif %}

      {% assign card_price_html = product.price | money %}

      <div class="j-product-card__price">

        {% if product.compare_at_price > product.price %}

          <span class="sale">
            {% if product.price_varies %}{{ 'product.from_price_html' | t: price: card_price_html }}{% else %}{{ card_price_html }}{% endif %}
          </span>

          <del>
            {{ product.compare_at_price | money }}
          </del>

        {% elsif product.price_varies %}

          <span>
            {{ 'product.from_price_html' | t: price: card_price_html }}
          </span>

        {% else %}

          <span>
            {{ card_price_html }}
          </span>

        {% endif %}

      </div>

      {% assign card_variant = product.selected_or_first_available_variant %}
      {% if card_variant.unit_price_measurement %}
        <p class="j-product-card__unit-price">
          {{ card_variant.unit_price | unit_price_with_measurement: card_variant.unit_price_measurement }}
        </p>
      {% endif %}

      {% assign color_option = null %}
      {% for option in product.options_with_values %}
        {% assign option_name_down = option.name | downcase %}
        {% if option_name_down == 'color' or option_name_down == 'colour' %}
          {% assign color_option = option %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if color_option %}
        {% assign swatch_limit = 4 %}
        {% comment %}
          Swatch hover-preview: hovering a color swatch swaps the card image
          to that color's photo (see assets/swatch-preview.js). The image
          comes from the option value's own variant, so a grid of cards
          doesn't load every product's full variant list. The variant list
          is only searched when an option value has no variant of its own.
        {% endcomment %}
        <div class="j-product-card__swatches">
          {% for value in color_option.values limit: swatch_limit %}
            {% assign color_key = value | remove: ' ' | remove: '-' | downcase %}

            {% assign preview_variant = value.variant %}
            {% if preview_variant == blank %}
              {% assign option_key = 'option' | append: color_option.position %}
              {% assign matching_variants = product.variants | where: option_key, value %}
              {% assign preview_variant = matching_variants.first %}
            {% endif %}
            {% assign preview_image = preview_variant.featured_image %}

            <span
              class="j-product-card__swatch"
              title="{{ value | escape }}"
              {% if preview_image %}
                data-preview-image="{{ preview_image | image_url: width: 700, format: 'webp' }}"
              {% endif %}
              {% if value.swatch.image %}
                style="background-image: url({{ value.swatch.image | image_url: width: 30, format: 'webp' }});"
              {% elsif value.swatch.color %}
                style="background-color: {{ value.swatch.color }};"
              {% else %}
                style="background-color: {{ color_key }};"
              {% endif %}
            ></span>
          {% endfor %}
          {% assign remaining_colors = color_option.values.size | minus: swatch_limit %}
          {% if remaining_colors > 0 %}
            <span class="j-product-card__swatch-more">
              {{ 'product.more_colors' | t: count: remaining_colors }}
            </span>
          {% endif %}
        </div>
      {% endif %}

    </div>

  </a>

</div>