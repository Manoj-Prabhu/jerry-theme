<div class="j-product-card">

  <a href="{{ product.url }}" class="j-product-card__link">

    <div class="j-product-card__image">

      {% if product.featured_image %}

        {% if priority %}
          {{
            product.featured_image
            | image_url: width: 700
            | image_tag:
              class: 'j-product-card__img',
              alt: product.title,
              widths: '350, 500, 700',
              sizes: '(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 25vw',
              fetchpriority: 'high'
          }}
        {% else %}
          {{
            product.featured_image
            | image_url: width: 700
            | image_tag:
              loading: 'lazy',
              class: 'j-product-card__img',
              alt: product.title,
              widths: '350, 500, 700',
              sizes: '(max-width: 768px) 100vw, (max-width: 1100px) 50vw, 25vw'
          }}
        {% endif %}

      {% else %}

        {{ 'product-1' | placeholder_svg_tag }}

      {% endif %}

      {% render 'product-badges', product: product %}

    </div>

    <div class="j-product-card__content">

      <h3>{{ product.title }}</h3>

      <div class="j-product-card__price">

        {% if product.compare_at_price > product.price %}

          <span class="sale">
            {{ product.price | money }}
          </span>

          <del>
            {{ product.compare_at_price | money }}
          </del>

        {% else %}

          <span>
            {{ product.price | money }}
          </span>

        {% endif %}

      </div>

    </div>

  </a>

  <button
    type="button"
    class="j-wishlist-button"
    data-handle="{{ product.handle }}"
    data-product-title="{{ product.title | escape }}"
    aria-label="{{ 'product.add_to_wishlist_html' | t: title: product.title | escape }}"
    aria-pressed="false"
  >
    ♡
  </button>

  {% unless show_quick_view == false %}
    <button
      type="button"
      class="j-quick-view-button"
      data-handle="{{ product.handle }}"
    >
      {{ 'product.quick_view' | t }}
    </button>
  {% endunless %}

</div>