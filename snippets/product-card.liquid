<div class="j-product-card">

  <a href="{{ product.url }}" class="j-product-card__link">

    <div class="j-product-card__image">
      {% if product.featured_image %}
        {{
          product.featured_image
          | image_url: width: 700
          | image_tag:
            loading: 'lazy',
            class: 'j-product-card__img',
            alt: product.title
        }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag }}
      {% endif %}

      {% if product.compare_at_price > product.price %}
        <span class="j-product-card__badge">
          Sale
        </span>
      {% endif %}
    </div>

    <div class="j-product-card__content">

      <h3>{{ product.title }}</h3>

      <div class="j-product-card__price">

        {% if product.compare_at_price > product.price %}

          <span class="sale">
            {{ product.price | money }}
          </span>

          <del>
            {{ product.compare_at_price | money }}
          </del>

        {% else %}

          <span>
            {{ product.price | money }}
          </span>

        {% endif %}

      </div>

    </div>

  </a>

  <button
    type="button"
    class="j-quick-view-button"
    data-handle="{{ product.handle }}"
  >
    Quick View
  </button>

</div>