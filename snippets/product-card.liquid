{% assign card_product = product %}

<a class="j-product-card" href="{{ card_product.url }}">
  <div class="j-product-card__image">
    {% if card_product.featured_image %}
      {{
        card_product.featured_image
        | image_url: width: 700
        | image_tag:
          loading: 'lazy',
          class: 'j-product-card__img',
          alt: card_product.title
      }}
    {% else %}
      {{ 'product-1' | placeholder_svg_tag }}
    {% endif %}
    {% if card_product.compare_at_price > card_product.price %}
      <span class="j-product-card__badge">
        Sale
      </span>
    {% endif %}
  </div>

  <div class="j-product-card__content">
    <h3>{{ card_product.title }}</h3>
    <div class="j-product-card__price">
      {% if card_product.compare_at_price > card_product.price %}
        <span class="sale">
          {{ card_product.price | money }}
        </span>
        <del>
          {{ card_product.compare_at_price | money }}
        </del>
      {% else %}
        <span>
          {{ card_product.price | money }}
        </span>
      {% endif %}
    </div>
  </div>
</a>