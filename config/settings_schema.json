[
  {
    "name": "theme_info",
    "theme_name": "Skeleton",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 20,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section spacing",
        "default": 64
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Card border radius",
        "default": 16
      }
    ]
  },
  {
    "name": "Cart & Shipping",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "info": "Used by the cart page's shipping progress bar and the header announcement bar's [amount] token. Set to 0 to disable the cart progress bar.",
        "default": 100
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary color",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "label": "Secondary color",
        "default": "#F3F4F6"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color",
        "default": "#16A34A"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#E5E7EB"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button background",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "button_text",
        "label": "Button text",
        "default": "#FFFFFF"
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "x",
        "label": "X (Twitter)"
      }
    ]
  }
]
