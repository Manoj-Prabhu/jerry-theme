[
  {
    "name": "theme_info",
    "theme_name": "Jerry",
    "theme_version": "1.0.0",
    "theme_author": "Mano Studio",
    "theme_documentation_url": "https://docs.google.com/document/d/e/2PACX-1vSNNZIXY2ICeKe11_2aAQRcBuWzeGO6qzO2y8WxZWDiZUZbA8hHGUFbGbjELBh7vvVFABDuoHggw_CS/pub",
    "theme_support_url": "https://docs.google.com/forms/d/e/1FAIpQLSfLI7316ezDx3ECzulggLQI0rqDFYsgVHtgEqngXYU1COyZAg/viewform"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_logo_font",
        "default": "poppins_n7",
        "label": "Logo font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "section_spacing",
        "min": 20,
        "max": 120,
        "step": 4,
        "unit": "px",
        "label": "Section spacing",
        "default": 64
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Card border radius",
        "default": 16
      },
      {
        "type": "range",
        "id": "base_border_radius",
        "min": 0,
        "max": 30,
        "step": 2,
        "unit": "px",
        "label": "Border radius",
        "info": "General rounding scale used across badges, swatches, cart notices, and other UI elements.",
        "default": 10
      }
    ]
  },
  {
    "name": "Effects",
    "settings": [
      {
        "type": "range",
        "id": "animation_speed",
        "min": 50,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "Animation speed",
        "info": "Scales hover and transition animation durations across the theme.",
        "default": 100
      },
      {
        "type": "range",
        "id": "shadow_strength",
        "min": 0,
        "max": 200,
        "step": 10,
        "unit": "%",
        "label": "Shadow strength",
        "info": "Scales the intensity of card and element shadows.",
        "default": 100
      }
    ]
  },
  {
    "name": "Breadcrumbs",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Enable breadcrumbs",
        "info": "Displays a navigation trail (e.g. Home > Collection > Product) so customers can see where they are and navigate back.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs_product",
        "label": "Show on product pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs_collection",
        "label": "Show on collection pages",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs_blog",
        "label": "Show on blog pages",
        "info": "Applies to both the blog listing and individual articles.",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs_page",
        "label": "Show on pages",
        "default": true
      }
    ]
  },
  {
    "name": "Cart & Shipping",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold ($)",
        "info": "Used by the cart page's shipping progress bar and the header announcement bar's [amount] token. Set to 0 to disable the cart progress bar.",
        "default": 100
      }
    ]
  },
  {
    "name": "Product Badges",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_new_badge",
        "label": "Show \"New\" badge",
        "default": true
      },
      {
        "type": "range",
        "id": "new_badge_days",
        "label": "\"New\" badge duration",
        "info": "Show the New badge for this many days after a product is created.",
        "min": 1,
        "max": 90,
        "step": 1,
        "unit": "d",
        "default": 30
      },
      {
        "type": "checkbox",
        "id": "show_sale_badge",
        "label": "Show \"Sale\" badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_sold_out_badge",
        "label": "Show \"Sold Out\" badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_bestseller_badge",
        "label": "Show \"Bestseller\" badge",
        "default": true
      },
      {
        "type": "text",
        "id": "bestseller_tag",
        "label": "Bestseller tag",
        "info": "Products with this tag (case-insensitive) show the Bestseller badge.",
        "default": "bestseller"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "primary_color",
        "label": "Primary color",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "secondary_color",
        "label": "Secondary color",
        "default": "#F3F4F6"
      },
      {
        "type": "color",
        "id": "accent_color",
        "label": "Accent color",
        "info": "Used as text color (links, sale price, nav hover) as well as backgrounds, so pick a shade that reaches at least 4.5:1 contrast against white for accessibility.",
        "default": "#15803D"
      },
      {
        "type": "color",
        "id": "border_color",
        "label": "Border color",
        "default": "#E5E7EB"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "Buttons",
    "settings": [
      {
        "type": "color",
        "id": "button_bg",
        "label": "Button background",
        "default": "#111827"
      },
      {
        "type": "color",
        "id": "button_text",
        "label": "Button text",
        "default": "#FFFFFF"
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button radius",
        "default": 12
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "x",
        "label": "X (Twitter)"
      }
    ]
  }
]
