<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %} Preload the logo — it's rendered eager in the header and is
      often the LCP element on non-product/non-hero pages. {% endcomment %}
    {% assign header_logo = sections['header'].settings.logo %}
    {% if header_logo != blank %}
      {% assign header_logo_width = sections['header'].settings.logo_width | default: 200 %}
      <link
        rel="preload"
        as="image"
        href="{{ header_logo | image_url: width: header_logo_width }}"
        imagesrcset="{{ header_logo | image_url: width: 120 }} 120w, {{ header_logo | image_url: width: 160 }} 160w, {{ header_logo | image_url: width: 200 }} 200w, {{ header_logo | image_url: width: 240 }} 240w, {{ header_logo | image_url: width: 300 }} 300w, {{ header_logo | image_url: width: 400 }} 400w"
      >
    {% endif %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'layout.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'utilities.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'breadcrumbs.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}
    {{ 'quick-view.css' | asset_url | stylesheet_tag }}
    {{ 'back-to-top.css' | asset_url | stylesheet_tag }}
    {{ 'scroll-reveal.css' | asset_url | stylesheet_tag }}
    {% comment %}
      featured-collection.css holds the shared .j-product-card / .j-wishlist-button
      component styles used by every product grid (collection, search, product
      recommendations) — not just the homepage section — so it stays global.
    {% endcomment %}
    {{ 'featured-collection.css' | asset_url | stylesheet_tag }}

    {% # Page-specific CSS — only loaded on the templates that use it %}
    {% if template.name == 'index' %}
      {{ 'hero.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'product' %}
      {{ 'product.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'collection' or template.name == 'search' or template.name == 'list-collections' %}
      {{ 'collection.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'page' and template.suffix == 'contact' %}
      {{ 'contact.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'blog' or template.name == 'article' %}
      {{ 'blog.css' | asset_url | stylesheet_tag }}
      {{ 'article.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'page' and template.suffix == 'faq' %}
      {{ 'faq.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body>
    {% sections 'header-group' %}
    <main id="MainContent" class="j-main">
      {{ content_for_layout }}
    </main>
    {% section 'cart-drawer' %}
    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    {% if template.name == 'product' %}
      <script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-variants.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'sticky-cart.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    <div
      class="j-quick-view-modal"
      id="QuickViewModal"
    >

      <div class="j-quick-view-overlay"></div>

      <div class="j-quick-view-content">

        <button
          class="j-quick-view-close"
          type="button"
        >
          ✕
        </button>

        <div id="QuickViewContent">
        </div>

      </div>

    </div>

    <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    {% if template.name == 'collection' or template.name == 'search' or template.name == 'list-collections' %}
      <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    <button
      type="button"
      id="BackToTop"
      class="j-back-to-top"
      aria-label="Back to top"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 12.5 10 7.5 15 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script src="{{ 'back-to-top.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'scroll-reveal.js' | asset_url }}" defer="defer"></script>
  </body>
</html>

