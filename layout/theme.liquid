<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% if settings.favicon != blank %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
    <script>
      window.themeMoneyFormat = {{ shop.money_format | json }};
      window.themeStrings = {
        cartItemCountOne: {{ 'cart.item_count' | t: count: 1 | json }},
        cartItemCountOther: {{ 'cart.item_count' | t: count: 2 | json }},
        cartEmpty: {{ 'cart.empty' | t | json }},
        cartContinueShopping: {{ 'cart.continue_shopping' | t | json }},
        cartRemoveItemHtml: {{ 'cart.remove_item_html' | t: title: '__TITLE__' | json }},
        cartDecreaseQuantity: {{ 'cart.decrease_quantity' | t | json }},
        cartIncreaseQuantity: {{ 'cart.increase_quantity' | t | json }},
        addToWishlistHtml: {{ 'product.add_to_wishlist_html' | t: title: '__TITLE__' | json }},
        removeFromWishlistHtml: {{ 'product.remove_from_wishlist_html' | t: title: '__TITLE__' | json }},
        readMore: {{ 'product.read_more' | t | json }},
        readLess: {{ 'product.read_less' | t | json }},
        viewFullDetails: {{ 'product.view_full_details' | t | json }},
        removeRecentSearchHtml: {{ 'search.remove_recent_search_html' | t: term: '__TERM__' | json }},
        recentlySearched: {{ 'search.recently_searched' | t | json }},
        searchClearAll: {{ 'search.clear_all' | t | json }},
        addToCart: {{ 'product.add_to_cart' | t | json }},
        adding: {{ 'product.adding' | t | json }},
        unavailable: {{ 'product.unavailable' | t | json }},
        soldOut: {{ 'product.sold_out' | t | json }},
        quantity: {{ 'product.quantity' | t | json }},
        addToCartError: {{ 'product.add_to_cart_error' | t | json }},
        updateQuantityError: {{ 'cart.update_quantity_error' | t | json }},
        decreaseQuantity: {{ 'cart.decrease_quantity' | t | json }},
        increaseQuantity: {{ 'cart.increase_quantity' | t | json }},
        quickView: {{ 'product.quick_view' | t | json }},
        pickupAvailableHtml: {{ 'product.pickup_available_html' | t: location: '__LOCATION__' | json }},
        pickupUnavailableHtml: {{ 'product.pickup_unavailable_html' | t: location: '__LOCATION__' | json }},
        linkCopied: {{ 'general.share.link_copied' | t | json }},
        sku: {{ 'product.sku' | t | json }}
      };
    </script>

    {% comment %}
      Shared engine used by the hero, testimonials, brand story and
      featured product slideshows — loaded here in <head> (rather than
      down by the other deferred scripts near the closing body tag)
      because those sections' own <script defer> tags for
      hero-slideshow.js/testimonials.js/brand-story.js/
      featured-product-slideshow.js render as part of the page's main
      content, which comes before the end of <body> in document order.
      Deferred scripts run in document order, so this has to appear
      earlier in the HTML than any of them, or they'd call
      createCrossfadeSlideshow() before it's defined.

      Every consumer of this file is a section that only exists on the
      homepage (per templates/index.json) — this was previously loaded
      unconditionally on every template, pure unused JS weight on
      product/collection/cart/search/etc. (part of Lighthouse's "Minimize
      main-thread work" / "Reduce unused JavaScript"). Scoped the same
      way shop-by-category-v2.js already is below. If a merchant ever
      adds one of those sections to a non-homepage template via the
      theme editor, this script would need to be added there too.
    {% endcomment %}
    {% if template.name == 'index' %}
      <script src="{{ 'crossfade-slideshow.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical variants (regular + bold primary, plus the
         logo font) — these render above the fold on first paint (body text,
         bold headings/prices, and the header logo). Everything else
         (italics, body-font bold, etc.) loads on-demand via @font-face.
    {% endcomment %}
    {% unless settings.type_primary_font.system? and settings.type_logo_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
    {% endunless %}

    {% unless settings.type_primary_font.system? %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}

      {% assign primary_font_bold = settings.type_primary_font | font_modify: 'weight', 'bold' %}
      {% if primary_font_bold != blank %}
        {{ primary_font_bold | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
      {% endif %}
    {% endunless %}

    {% unless settings.type_logo_font.system? %}
      {{ settings.type_logo_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% comment %}
      Logo preload: handled via the `preload: true` argument on the
      image_tag filter directly in sections/header.liquid (the idiomatic
      Shopify approach), rather than a manual <link> here.
    {% endcomment %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'variables.css' | asset_url | stylesheet_tag }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'layout.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'utilities.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'breadcrumbs.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'cart.css' | asset_url | stylesheet_tag }}

    {% comment %}
      Non-critical CSS (not needed for first paint — quick view only opens on
      click, back-to-top only appears after scrolling, scroll-reveal only
      matters once elements approach the viewport): loaded without blocking
      render via the preload+swap pattern, with a <noscript> fallback.

      new-products.css, testimonials.css and brand-story.css style
      homepage sections that sit well below the fold (after Hero, Shop by
      Category and Featured Collection) — nothing they style is visible
      before the browser has had time to fetch them anyway, so blocking
      the whole page's first paint on them (Lighthouse's "Render-blocking
      requests") buys nothing. hero.css and shop-by-category.css stay
      above, since those two ARE above the fold and deferring them would
      risk a flash of unstyled content.
    {% endcomment %}
    {% # theme-check-disable AssetPreload %}
    {% assign non_critical_css = 'quick-view.css,back-to-top.css,scroll-reveal.css' | split: ',' %}
    {% if template.name == 'index' %}
      {% assign index_deferred_css = 'new-products.css,testimonials.css,brand-story.css' | split: ',' %}
      {% assign non_critical_css = non_critical_css | concat: index_deferred_css %}
    {% endif %}
    {% for file in non_critical_css %}
      <link rel="preload" href="{{ file | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
      <noscript>{{ file | asset_url | stylesheet_tag }}</noscript>
    {% endfor %}
    {% # theme-check-enable AssetPreload %}

    {% comment %}
      featured-collection.css holds the shared .j-product-card / .j-wishlist-button
      component styles used by every product grid (collection, search, product
      recommendations) — not just the homepage section — so it stays global.
    {% endcomment %}
    {{ 'featured-collection.css' | asset_url | stylesheet_tag }}

    {% # Page-specific CSS — only loaded on the templates that use it %}
    {% if template.name == 'index' %}
      {{ 'hero.css' | asset_url | stylesheet_tag }}
      {{ 'shop-by-category.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'product' %}
      {{ 'product.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'collection' or template.name == 'search' or template.name == 'list-collections' %}
      {{ 'collection.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'search' %}
      {{ 'search.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'page' and template.suffix == 'contact' %}
      {{ 'contact.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'page' and template.suffix == 'about' %}
      {{ 'about.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'blog' or template.name == 'article' %}
      {{ 'blog.css' | asset_url | stylesheet_tag }}
      {{ 'article.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'page' and template.suffix == 'faq' %}
      {{ 'faq.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == 'customers' %}
      {{ 'customers.css' | asset_url | stylesheet_tag }}
    {% endif %}
    {% if template.name == '404' %}
      {{ '404.css' | asset_url | stylesheet_tag }}
    {% endif %}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}
  </head>

  <body class="{% if template.name == 'index' %}j-body--home{% elsif template.name == 'product' %}j-body--product{% else %}j-body--tinted{% endif %}">
    {% comment %}
      Skip-to-content link (WCAG 2.4.1 bypass blocks) — the very first
      focusable element on every page, so a keyboard/screen reader user
      can jump straight to #MainContent instead of tabbing through the
      full header/nav on every single page load. Hidden off-screen until
      it receives focus (see .j-skip-link in base.css), same convention
      as the .visually-hidden utility elsewhere in the theme but with a
      focus-visible override since this one specifically needs to become
      visible.
    {% endcomment %}
    <a href="#MainContent" class="j-skip-link">{{ 'general.skip_to_content' | t }}</a>

    {% sections 'header-group' %}
    <main id="MainContent" class="j-main">
      {{ content_for_layout }}
    </main>
    {% section 'cart-drawer' %}
    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
    {% comment %}
      Tiny shared utility (see assets/fly-to-cart.js) — loaded sitewide
      since both cart.js (every page) and sticky-cart.js (product pages)
      call window.JerryFlyToCart from their own add-to-cart handlers.
    {% endcomment %}
    <script src="{{ 'fly-to-cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'text-reveal.js' | asset_url }}" defer="defer"></script>
    <script>
      window.jerryMascotConfig = {
        src: {{ 'mascot-cat.riv' | asset_url | json }},
        stateMachine: "State Machine 1",
        riveUrl: {{ 'rive.min.js' | asset_url | json }},
        scriptUrl: {{ 'mascot.js' | asset_url | json }},
      };
    </script>
    {% if template.name == 'product' %}
      <script src="{{ 'product-gallery.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-variants.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'sticky-cart.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'product-recommendations.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {% if template.name == '404' %}
      <script src="{{ '404.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    <div
      class="j-quick-view-modal"
      id="QuickViewModal"
    >

      <div class="j-quick-view-overlay"></div>

      <div
        class="j-quick-view-content"
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'product.quick_view' | t }}"
      >

        <button
          class="j-quick-view-close"
          type="button"
          aria-label="{{ 'product.quick_view_close' | t }}"
        >
          ✕
        </button>

        <div id="QuickViewContent">
        </div>

      </div>

    </div>

    <script src="{{ 'quick-view.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'wishlist.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'swatch-preview.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'featured-collection.js' | asset_url }}" defer="defer"></script>
    {% comment %}
      Tiny (just sets up an IntersectionObserver) — the actual Rive
      runtime this fetches on scroll-into-view is what's expensive, and
      that only happens once the footer is actually reached. See
      assets/footer-mascot.js.
    {% endcomment %}
    <script src="{{ 'footer-mascot.js' | asset_url }}" defer="defer"></script>
    {% if template.name == 'collection' or template.name == 'search' or template.name == 'list-collections' %}
      <script src="{{ 'collection.js' | asset_url }}" defer="defer"></script>
    {% endif %}
    {% if template.name == 'index' %}
      {% comment %}
        shop-by-category.js was previously loaded on every page — that
        section only exists on the homepage per templates/index.json, so
        it was pure unused JS weight everywhere else (flagged by
        Lighthouse's "Reduce unused JavaScript"). Scoped the same way
        hero-slideshow.js and brand-story.js already are below. If a
        merchant ever adds a Shop by Category section to a different
        template via the theme editor, this script would need to be added
        there too.
      {% endcomment %}
      {% comment %}
        Renamed from shop-by-category.js to shop-by-category-v2.js —
        Cloudflare's CDN in front of this store was caching the old
        filename's URL for hours regardless of content changes pushed to
        it (appears to ignore the asset_url version query string for this
        path), so repeated fixes to that file weren't reaching real
        visitors or Lighthouse. A new filename is a new cache key,
        guaranteed to bypass whatever was serving the stale copy.
      {% endcomment %}
      <script src="{{ 'shop-by-category-v2.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'hero-slideshow.js' | asset_url }}" defer="defer"></script>
      <script src="{{ 'brand-story.js' | asset_url }}" defer="defer"></script>
    {% endif %}

    <button
      type="button"
      id="BackToTop"
      class="j-back-to-top"
      aria-label="{{ 'general.back_to_top' | t }}"
    >
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 12.5 10 7.5 15 12.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>

    <script src="{{ 'back-to-top.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'scroll-reveal.js' | asset_url }}" defer="defer"></script>
  </body>
</html>

